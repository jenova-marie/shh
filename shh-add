  print_header "Shh SSH Key Manager"
  echo ""
  echo -e "${UNDERLINE}${BOLD}USAGE:${RESET}"
  echo -e "  ${WHITE}$(basename "$0") ${CYAN}[options] ${PINK}<file-path> ${PINK}[property-name] ${PINK}[region]${RESET}"
  echo -e "  ${WHITE}$(basename "$0") ${CYAN}--generate ${CYAN}[options] ${PINK}[property-name] ${PINK}[region]${RESET}"
  echo -e "  ${WHITE}$(basename "$0") ${CYAN}--user${RESET}"
  echo ""
  echo -e "${UNDERLINE}${BOLD}ARGUMENTS:${RESET}"
  echo -e "  ${PINK}file-path${RESET}      ${WHITE}Path to the SSH key file (not needed with --generate)${RESET}"
  echo -e "  ${PINK}property-name${RESET}  ${WHITE}Name to store the key as (defaults to filename or hostname with generate)${RESET}"
  echo -e "  ${PINK}region${RESET}         ${WHITE}AWS region (defaults to ${RESET}${YELLOW}$DEFAULT_REGION${RESET}${WHITE})${RESET}"
  echo ""
  echo -e "${BLUE}${BOLD}KEY GENERATION OPTIONS:${RESET}"
  echo -e "  ${CYAN}--generate${RESET}     ${WHITE}Generate a new SSH key instead of uploading an existing one${RESET}"
  echo -e "  ${CYAN}--type ${PINK}TYPE${RESET}    ${WHITE}Key type: ${GREEN}ed25519${RESET} (default), ${GREEN}rsa${RESET}, ${GREEN}ecdsa${RESET}, ${GREEN}dsa${RESET}${RESET}"
  echo -e "  ${CYAN}--bits ${PINK}BITS${RESET}    ${WHITE}Key size in bits (for RSA keys, default: ${RESET}${YELLOW}4096${RESET}${WHITE})${RESET}"
  echo -e "  ${CYAN}--rounds ${PINK}N${RESET}     ${WHITE}KDF rounds for key generation (default: ${RESET}${YELLOW}100${RESET}${WHITE})${RESET}"
  echo -e "  ${CYAN}--comment ${PINK}TXT${RESET}  ${WHITE}Key comment (default: ${RESET}${YELLOW}username@hostname${RESET}${WHITE})${RESET}"
  echo -e "  ${CYAN}--path ${PINK}PATH${RESET}    ${WHITE}Path to save generated key (default: temporary location)${RESET}"
  echo -e "  ${CYAN}--auto${RESET}         ${WHITE}Non-interactive mode, use defaults for all prompts${RESET}"
  echo -e "  ${CYAN}--shred${RESET}        ${WHITE}Securely delete the key files after uploading${RESET}"
  echo -e "  ${CYAN}--ram-disk${RESET}     ${WHITE}Create keys in RAM disk for zero disk persistence${RESET}"
  echo ""
  echo -e "${BLUE}${BOLD}UPLOAD OPTIONS:${RESET}"
  echo -e "  ${CYAN}--user${RESET}         ${WHITE}Scan ${PINK}~/.ssh${WHITE} for common keys and add them interactively${RESET}"
  echo -e "  ${CYAN}--no-pub${RESET}       ${WHITE}Don't upload the public key (.pub) alongside the private key${RESET}"
  echo -e "  ${CYAN}--only${RESET}         ${WHITE}Only upload the specified file, skip public key and fingerprint${RESET}"
  echo -e "  ${CYAN}--debug${RESET}        ${WHITE}Enable verbose debugging output${RESET}"
  echo -e "  ${CYAN}--no-ssh-add${RESET}   ${WHITE}Don't add the key to the SSH agent${RESET}"
  echo -e "  ${CYAN}--env${RESET}          ${WHITE}Manage environment variables with shh-env${RESET}"
  echo -e "  ${CYAN}--help${RESET}         ${WHITE}Display this help message${RESET}"
  echo ""
  echo -e "${UNDERLINE}${BOLD}ENVIRONMENT VARIABLES:${RESET} ${GRAY}(in order of precedence)${RESET}"
  echo -e "  ${PINK}SHH_REGION${RESET}           ${WHITE}Preferred AWS region${RESET}"
  echo -e "  ${PINK}AWS_REGION${RESET}           ${WHITE}Alternative AWS region${RESET}"
  echo -e "  ${PINK}AWS_DEFAULT_REGION${RESET}   ${WHITE}Default AWS region${RESET}"
  echo -e "  ${PINK}SHH_SECRETS${RESET}          ${WHITE}AWS Secrets Manager secret name${RESET}"
  echo ""
  echo -e "${YELLOW}${BOLD}EXAMPLES:${RESET}"
  echo -e "  ${GRAY}# Upload an existing key${RESET}"
  echo -e "  ${WHITE}$(basename "$0") ~/.ssh/id_ed25519 myserver us-west-2${RESET}"
  echo -e ""
  echo -e "  ${GRAY}# Generate a new key and upload it${RESET}"
  echo -e "  ${WHITE}$(basename "$0") --generate myserver --auto${RESET}"
  echo -e ""
  echo -e "  ${GRAY}# Generate a key in RAM and securely shred it${RESET}"
  echo -e "  ${WHITE}$(basename "$0") --generate --ram-disk --shred myserver${RESET}"
  exit 1
}

# Function for debug logging
debug_log() {
  if $DEBUG_MODE; then
    echo -e "${GRAY}[DEBUG] $1${RESET}"
  fi
}

# Check dependencies
check_dependencies() {
  local required_commands="aws jq base64 ssh-keygen"
  
  # Add ssh-agent commands if we're adding to SSH agent
  if [ "$ADD_TO_AGENT" = true ]; then
    required_commands="$required_commands ssh-add ssh-agent grep"
  fi
  
  # Add shred if we're using that option
  if [ "$SHRED_KEY" = true ]; then
    required_commands="$required_commands shred"
  fi
  
  for cmd in $required_commands; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
      echo -e "${YELLOW}${BOLD}Error:${RESET} Required command '${CYAN}$cmd${RESET}' not found."
      case "$cmd" in
        aws)
          echo -e "  ${WHITE}Please install the AWS CLI: ${CYAN}https://aws.amazon.com/cli/${RESET}"
          ;;
        jq)
          echo -e "  ${WHITE}Please install jq: '${CYAN}apt-get install jq${RESET}' or '${CYAN}brew install jq${RESET}'"
          ;;
        ssh-keygen|ssh-add|ssh-agent)
          echo -e "  ${WHITE}Please install OpenSSH: '${CYAN}apt-get install openssh-client${RESET}' or '${CYAN}brew install openssh${RESET}'"
          ;;
        shred)
          echo -e "  ${WHITE}Please install coreutils: '${CYAN}apt-get install coreutils${RESET}' or '${CYAN}brew install coreutils${RESET}'"
          ;;
        *)
          echo -e "  ${WHITE}Please install the required dependency.${RESET}"
          ;;
      esac
      exit 1
    fi
  done
}

# Function to securely shred a file
secure_shred() {
  local file="$1"
  local shred_tool

  # Verify the file exists
  if [ ! -f "$file" ]; then
    debug_log "File not found for shredding: $file"
    return 0
  fi

  echo -e "${YELLOW}${BOLD}Securely shredding file:${RESET} ${CYAN}$file${RESET}"

  # Check available secure deletion tools
  if command -v shred >/dev/null 2>&1; then
    shred_tool="shred"
    debug_log "Using shred for secure deletion"
    # Use 3 passes with zeros at end for enhanced security
    shred -vz -n 3 "$file" >/dev/null 2>&1
    # Remove the file after shredding
    rm -f "$file"
    echo -e "${GREEN}✓ File securely deleted with ${CYAN}shred${RESET}"
  elif command -v srm >/dev/null 2>&1; then
    shred_tool="srm"
    debug_log "Using srm for secure deletion"
    srm -vz "$file" >/dev/null 2>&1
    echo -e "${GREEN}✓ File securely deleted with ${CYAN}srm${RESET}"
  elif command -v wipe >/dev/null 2>&1; then
    shred_tool="wipe"
    debug_log "Using wipe for secure deletion"
    wipe -fq "$file" >/dev/null 2>&1
    echo -e "${GREEN}✓ File securely deleted with ${CYAN}wipe${RESET}"
  else
    # Fallback if no secure deletion tools are available
    debug_log "No specialized secure deletion tools found, using basic deletion"
    # Overwrite with random data then zeros before deletion
    dd if=/dev/urandom of="$file" bs=1k count=1 conv=notrunc >/dev/null 2>&1
    dd if=/dev/zero of="$file" bs=1k count=1 conv=notrunc >/dev/null 2>&1
    rm -f "$file"
    echo -e "${YELLOW}⚠️ Basic secure deletion used (no specialized tools available)${RESET}"
  fi

  return 0
}

# Function to cleanup temp files
cleanup() {
  if [ -n "$TEMP_DIR" ] && [ -d "$TEMP_DIR" ]; then
    debug_log "Cleaning up temporary directory: $TEMP_DIR"
    if [ "$SHRED_KEY" = true ]; then
      echo -e "\n${BLUE}${BOLD}Performing secure cleanup...${RESET}"
      # Find all files in the temp dir and shred them
      find "$TEMP_DIR" -type f -exec bash -c 'secure_shred "$0"' {} \;
    fi
    rm -rf "$TEMP_DIR"
  fi
}

# Set trap to cleanup on exit
trap cleanup EXIT INT TERM

# Function to actually perform the key addition to AWS Secrets Manager
execute_add_key() {
  # This function assumes FILE_PATH, PROPERTY_NAME, REGION, SECRET_NAME,
  # UPLOAD_PUB, ADD_TO_AGENT, DEBUG_MODE, ONLY_MODE, UPLOAD_FP are set appropriately (globally).

  # Export values for potential use by other scripts or aws cli calls within this function
  export SHH_SECRETS="$SECRET_NAME"
  export SHH_REGION="$REGION"
  export AWS_DEFAULT_REGION="$REGION"

  # SECURITY CHECK: Verify user has access to the key by trying to add it to ssh-agent first
  if [ "$ADD_TO_AGENT" = true ]; then
    print_section "Verifying Key Access for ${CYAN}$FILE_PATH${RESET}"
    print_status step "Verifying access to private key..."
    
    if ! pgrep -x "ssh-agent" >/dev/null 2>&1; then
      debug_log "Starting ssh-agent..."
      eval "$(ssh-agent -s)" >/dev/null # Silently start if not in debug
      if $DEBUG_MODE; then eval "$(ssh-agent -s)"; else eval "$(ssh-agent -s)" >/dev/null; fi
    fi
    
    SSH_KEY_FP=""
    if [ -f "$FILE_PATH.pub" ]; then
      SSH_KEY_FP=$(ssh-keygen -lf "$FILE_PATH.pub" 2>/dev/null | awk '{print $2}' || echo "")
      debug_log "Fingerprint for $FILE_PATH: $SSH_KEY_FP"
      
      if [ -n "$SSH_KEY_FP" ] && ssh-add -l 2>/dev/null | grep -qF "$SSH_KEY_FP"; then
        debug_log "Key $FILE_PATH is already loaded in ssh-agent."
        print_status success "Key already loaded in SSH agent."
      else
        debug_log "Attempting to add key $FILE_PATH to ssh-agent..."
        if ! ssh-add "$FILE_PATH" 2>/dev/null; then
          print_status error "Failed to add key to SSH agent. Check passphrase or permissions for ${CYAN}$FILE_PATH${RESET}."
          return 1 # Indicate failure
        fi
        print_status success "Successfully verified access to private key."
      fi
    else
      debug_log "No public key for $FILE_PATH, attempting to add private key directly..."
      if ! ssh-add "$FILE_PATH" 2>/dev/null; then
        print_status error "Failed to add key to SSH agent. Check passphrase or permissions for ${CYAN}$FILE_PATH${RESET}."
        return 1 # Indicate failure
      fi
      print_status success "Successfully verified access to private key."
    fi
  fi

  if ! check_aws_credentials "$REGION"; then
    return 1 # Indicate failure
  fi

  print_section "Uploading to AWS Secrets Manager: ${CYAN}$PROPERTY_NAME${RESET}"
  print_status info "Using AWS Secret: ${CYAN}$SECRET_NAME${WHITE} in region: ${CYAN}$REGION${WHITE}"

  debug_log "Attempting to get existing secret value for $SECRET_NAME..."
  EXISTING_SECRET=
  if ! EXISTING_SECRET=$(aws secretsmanager get-secret-value --secret-id "$SECRET_NAME" --region "$REGION" --query SecretString --output text 2>/dev/null); then
    print_status warning "Secret '$SECRET_NAME' not found or access denied. Initializing new secret..."
    
    debug_log "Checking if secret $SECRET_NAME exists but we lack permissions..."
    if aws secretsmanager describe-secret --secret-id "$SECRET_NAME" --region "$REGION" >/dev/null 2>&1; then
      print_status error "Secret exists but you don't have permission to read it."
      return 1
    fi
    
    print_status step "Attempting to create secret '${CYAN}$SECRET_NAME${BLUE}' using shh-admin..."
    admin_debug_flag=""
    if $DEBUG_MODE; then admin_debug_flag="--debug"; fi
    
    if ! "$SCRIPT_DIR/shh-admin" --secret "$SECRET_NAME" --region "$REGION" --create $admin_debug_flag; then
      print_status error "Failed to create secret '${CYAN}$SECRET_NAME${RESET}' using shh-admin."
      return 1
    fi
    
    if ! EXISTING_SECRET=$(aws secretsmanager get-secret-value --secret-id "$SECRET_NAME" --region "$REGION" --query SecretString --output text 2>/dev/null); then
      print_status error "Failed to retrieve newly created secret '${CYAN}$SECRET_NAME${RESET}'."
      return 1
    fi
    debug_log "Initialized new secret $SECRET_NAME with empty JSON object"
  fi

  debug_log "Encoding file content from: $FILE_PATH"
  ENCODED_FILE_CONTENT=$(base64 -w 0 < "$FILE_PATH")
  debug_log "Encoded content length for $PROPERTY_NAME: ${#ENCODED_FILE_CONTENT} characters"

  if echo "$EXISTING_SECRET" | jq -e --arg key "$PROPERTY_NAME" 'has($key)' >/dev/null; then
    print_status warning "Property '${CYAN}$PROPERTY_NAME${YELLOW}' already exists. Overwriting...${RESET}"
  else
    print_status info "Adding new property '${CYAN}$PROPERTY_NAME${BLUE}' to secret '${CYAN}$SECRET_NAME${BLUE}'.${RESET}"
  fi

  debug_log "Merging property $PROPERTY_NAME into existing secret JSON..."
  UPDATED_SECRET=$(echo "$EXISTING_SECRET" | jq --arg key "$PROPERTY_NAME" --arg value "$ENCODED_FILE_CONTENT" '. + {($key): $value}')

  if [ "$UPLOAD_PUB" = true ] && [ "$ONLY_MODE" = false ]; then
    PUB_FILE="$FILE_PATH.pub"
    if [ -f "$PUB_FILE" ]; then
      print_status step "Adding public key ${CYAN}$PROPERTY_NAME.pub${RESET}..."
      debug_log "Reading public key from: $PUB_FILE"
      ENCODED_PUB_CONTENT=$(cat "$PUB_FILE")
      UPDATED_SECRET=$(echo "$UPDATED_SECRET" | jq --arg key "$PROPERTY_NAME.pub" --arg value "$ENCODED_PUB_CONTENT" '. + {($key): $value}')
      print_status success "Public key '${CYAN}$PROPERTY_NAME.pub${RESET}' added."
    else
      print_status warning "Public key file '${CYAN}$PUB_FILE${RESET}' not found. Skipping."
    fi
  fi

  print_section "Adding Key Metadata for ${CYAN}$PROPERTY_NAME${RESET}"
  TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
  HOSTNAME_META=$(hostname)
  USERNAME_META=$(whoami)
  KEY_TYPE_META=$(ssh-keygen -l -f "$FILE_PATH" 2>/dev/null | awk '{print $3}' | sed 's/[()]//g; s/^ssh-//' || echo "unknown")
  KEY_SIZE_META=$(ssh-keygen -l -f "$FILE_PATH" 2>/dev/null | awk '{print $1}' || echo "unknown")
  COMMENT_META=$(ssh-keygen -l -f "$FILE_PATH" 2>/dev/null | sed 's/^[^ ]* [^ ]* [^ ]* //' || echo "")

  SSH_KEY_FP_META=""
  if [ "$UPLOAD_FP" = true ] && [ "$ONLY_MODE" = false ]; then
    if [ -f "$FILE_PATH.pub" ]; then
      print_status step "Calculating SSH key fingerprint..."
      SSH_KEY_FP_META=$(ssh-keygen -lf "$FILE_PATH.pub" | awk '{print $2}')
      debug_log "Fingerprint for metadata: $SSH_KEY_FP_META"
    else
      print_status warning "No public key file for fingerprinting metadata."
    fi
  fi

  META_KEY="$PROPERTY_NAME.meta"
  VERSION=1
  CREATED_TIMESTAMP="$TIMESTAMP"
  PREV_ROTATION_TIMESTAMP=""

  if echo "$EXISTING_SECRET" | jq -e --arg key "$META_KEY" 'has($key)' >/dev/null; then
    debug_log "Found existing metadata for $META_KEY, updating version"
    EXISTING_META_CONTENT=$(echo "$EXISTING_SECRET" | jq -r --arg key "$META_KEY" '.[$key]')
    if echo "$EXISTING_META_CONTENT" | jq . >/dev/null 2>&1; then
      PREV_VERSION=$(echo "$EXISTING_META_CONTENT" | jq -r '.version // 0')
      VERSION=$((PREV_VERSION + 1))
      CREATED_TIMESTAMP=$(echo "$EXISTING_META_CONTENT" | jq -r '.created // "'$TIMESTAMP'"')
      PREV_ROTATION_TIMESTAMP=$(echo "$EXISTING_META_CONTENT" | jq -r '.updated // ""')
    else
      debug_log "Existing metadata for $META_KEY is not valid JSON, starting fresh."
    fi
  fi

  ROTATION_DUE_DATE=$(date -v+90d -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || date -d "+90 days" -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || echo "")
  META_JSON_BASE=$(jq -n \
    --arg version "$VERSION" \
    --arg created "$CREATED_TIMESTAMP" \
    --arg updated "$TIMESTAMP" \
    --arg updater "$USERNAME_META@$HOSTNAME_META" \
    --arg key_type "$KEY_TYPE_META" \
    --arg key_size "$KEY_SIZE_META" \
    --arg comment "$COMMENT_META" \
    --arg rotation "$ROTATION_DUE_DATE" \
    '{
      "version": ($version | tonumber),
      "created": $created,
      "updated": $updated,
      "updated_by": $updater,
      "key_type": $key_type,
      "key_size": $key_size,
      "comment": $comment,
      "rotation_recommended": $rotation
    }')

  if [ -n "$SSH_KEY_FP_META" ]; then
    META_JSON_BASE=$(echo "$META_JSON_BASE" | jq --arg fp "$SSH_KEY_FP_META" '. + {"fingerprint": $fp}')
  fi

  if [ -n "$PREV_ROTATION_TIMESTAMP" ] && [ "$VERSION" -gt 1 ] && echo "$EXISTING_META_CONTENT" | jq . >/dev/null 2>&1; then
    META_JSON_BASE=$(echo "$META_JSON_BASE" | jq --arg ts "$PREV_ROTATION_TIMESTAMP" '. + {"last_rotation": $ts}')
    ROTATION_HISTORY_CANDIDATE=$(echo "$EXISTING_META_CONTENT" | jq '.rotation_history // []')
    ROTATION_ENTRY=$(jq -n --arg ts "$PREV_ROTATION_TIMESTAMP" --arg v "$PREV_VERSION" '{timestamp: $ts, version: ($v | tonumber)}')
    UPDATED_HISTORY=$(echo "$ROTATION_HISTORY_CANDIDATE" | jq --argjson entry "$ROTATION_ENTRY" '. + [$entry]' | jq 'sort_by(.timestamp) | reverse | .[0:9]') # Keep last 10
    META_JSON_BASE=$(echo "$META_JSON_BASE" | jq --argjson history "$UPDATED_HISTORY" '. + {rotation_history: $history}')
  fi

  META_JSON_STRING=$(echo "$META_JSON_BASE" | jq -c .)
  debug_log "Generated metadata for $PROPERTY_NAME: $META_JSON_STRING"
  UPDATED_SECRET=$(echo "$UPDATED_SECRET" | jq --arg key "$META_KEY" --arg value "$META_JSON_STRING" '. + {($key): $value}')
  print_status success "Metadata for '${CYAN}$PROPERTY_NAME${GREEN}' added (version ${YELLOW}$VERSION${GREEN}).${RESET}"

  FP_KEY_OLD="$PROPERTY_NAME.fp"
  if echo "$UPDATED_SECRET" | jq -e --arg key "$FP_KEY_OLD" 'has($key)' >/dev/null; then
    debug_log "Removing deprecated fingerprint property '$FP_KEY_OLD' for $PROPERTY_NAME"
    UPDATED_SECRET=$(echo "$UPDATED_SECRET" | jq --arg key "$FP_KEY_OLD" 'del(.[$key])')
  fi

  print_status step "Updating secret '${CYAN}$SECRET_NAME${RESET}' in AWS Secrets Manager..."
  TMP_JSON_FILE=$(mktemp)
echo "$UPDATED_SECRET" > "$TMP_JSON_FILE"
  aws_debug_flag=""
  if $DEBUG_MODE; then aws_debug_flag="--debug"; fi

  if ! aws secretsmanager put-secret-value --secret-id "$SECRET_NAME" --region "$REGION" --secret-string file://"$TMP_JSON_FILE" $aws_debug_flag >/dev/null 2>&1 && ! $DEBUG_MODE; then
    # Retry with debug if failed silently, to show error
    if ! aws secretsmanager put-secret-value --secret-id "$SECRET_NAME" --region "$REGION" --secret-string file://"$TMP_JSON_FILE" --debug; then 
        rm -f "$TMP_JSON_FILE"
        print_status error "Failed to update secret '${CYAN}$SECRET_NAME${RESET}'. Check AWS permissions / output above."
        return 1
    fi
  elif $DEBUG_MODE; then # If debug mode was on initially
      if ! aws secretsmanager put-secret-value --secret-id "$SECRET_NAME" --region "$REGION" --secret-string file://"$TMP_JSON_FILE" $aws_debug_flag; then
        rm -f "$TMP_JSON_FILE"
        print_status error "Failed to update secret '${CYAN}$SECRET_NAME${RESET}' (debug mode). Check AWS permissions / output above."
        return 1
      fi
  fi
  rm -f "$TMP_JSON_FILE"
  print_status success "Successfully updated secret '${CYAN}$SECRET_NAME${WHITE}' with property '${CYAN}$PROPERTY_NAME${WHITE}'."
  return 0 # Indicate success
}

# Function to scan ~/.ssh for common keys and add them interactively
process_user_keys() {
  print_section "User SSH Key Import from ~/.ssh"
  local ssh_dir="$HOME/.ssh"
  local username
  username=$(whoami)
  local keys_found_count=0
  local keys_added_count=0

  # Standard key base names and their types
  declare -A key_map
  key_map["id_rsa"]="rsa"
  key_map["id_ed25519"]="ed25519"
  key_map["id_ecdsa"]="ecdsa"
  key_map["id_dsa"]="dsa"
  # Consider adding _sk variants if needed: id_ecdsa_sk, id_ed25519_sk

  for base_name in "${!key_map[@]}"; do
    local current_key_path="$ssh_dir/$base_name"
    local key_type="${key_map[$base_name]}"
    local proposed_property_name="${username}_${key_type}"

    if [ -f "$current_key_path" ]; then
      keys_found_count=$((keys_found_count + 1))
      print_status info "Found key: ${CYAN}$current_key_path${RESET}"

      local confirm_add
      echo -en "${PINK}${BOLD}Add this key as '${CYAN}$proposed_property_name${PINK}'? (Y/n/s)kip: ${RESET}${WHITE}"
      read -r confirm_add
      local confirm_add_lower
      confirm_add_lower=$(echo "$confirm_add" | tr '[:upper:]' '[:lower:]')

      if [[ "$confirm_add_lower" == "s" || "$confirm_add_lower" == "skip" ]]; then
        print_status step "Skipping ${CYAN}$base_name${RESET}."
        echo "" # Add a blank line for readability
        continue
      elif [[ "$confirm_add_lower" == "n" ]]; then
        print_status step "Will not add ${CYAN}$base_name${RESET}."
        echo "" # Add a blank line for readability
        continue
      fi
      # Default is Yes (empty input or 'y')

      # Set globals for the call to execute_add_key
      # Stash and restore is good practice if these vars could have other meanings outside this loop,
      # but in --user mode, these are primarily for execute_add_key calls.
      local original_file_path="$FILE_PATH"
      local original_property_name="$PROPERTY_NAME"

      FILE_PATH="$current_key_path"
      PROPERTY_NAME="$proposed_property_name"
      # REGION and SECRET_NAME are already global and set by check_shh_environment or defaults.
      # UPLOAD_PUB, ADD_TO_AGENT, etc., will use their current global settings.

      print_status step "Attempting to add ${CYAN}$FILE_PATH${RESET} as ${CYAN}$PROPERTY_NAME${RESET}..."
      if execute_add_key; then # execute_add_key returns 0 on success
        keys_added_count=$((keys_added_count + 1))
        # Success message is already in execute_add_key
      else
        # Error message is already in execute_add_key
        print_status error "Failed to add key ${CYAN}$FILE_PATH${RESET}. See details above."
      fi
      
      # Restore original values if they were set for some other purpose
      FILE_PATH="$original_file_path"
      PROPERTY_NAME="$original_property_name"
      echo "" # Add a blank line for readability between keys
    fi
  done

  if [ "$keys_found_count" -eq 0 ]; then
    print_status warning "No standard 'id_*' SSH key files found in ${CYAN}$ssh_dir${RESET}."
  else
    print_status success "User key scan complete. Processed $keys_found_count potential key(s). Added $keys_added_count key(s)."
  fi
  return 0 # process_user_keys itself succeeded or completed
}

# Generate SSH key function
generate_ssh_key() {
  local key_path="$1"
  local key_type="$2"
  local key_bits="$3"
  local key_rounds="$4"
  local key_comment="$5"

  debug_log "Generating $key_type key with $key_rounds rounds and comment: $key_comment"
  
  local key_opts=()
  key_opts+=("-t" "$key_type")
  if [ "$key_type" = "rsa" ]; then
    key_opts+=("-b" "$key_bits")
  fi
  key_opts+=("-a" "$key_rounds")
  key_opts+=("-f" "$key_path")
  key_opts+=("-C" "$key_comment")
  
  print_section "SSH Key Generation"
  print_status info "Key type: ${CYAN}$key_type${RESET}, Bits: ${CYAN}${key_bits:-N/A}${RESET}, Rounds: ${CYAN}$key_rounds${RESET}"
  print_status key "Generating key at: ${CYAN}$key_path${RESET}"
  
  if [ "$AUTO_MODE" = true ]; then
    print_status step "Generating key non-interactively (empty passphrase)..."
    ssh-keygen "${key_opts[@]}" -N "" -q
  else
    print_status step "Please follow the prompts from ssh-keygen below:"
    echo -e "${GRAY}(You will be asked to enter a passphrase for the key)${RESET}"
    ssh-keygen "${key_opts[@]}"
  fi
  
  if [ -f "$key_path" ] && [ -f "$key_path.pub" ]; then
    print_status success "SSH key pair generated successfully."
    
    # Display public key for convenience, especially if not in auto mode
    if [ "$AUTO_MODE" = false ]; then
        echo -e "${BLUE}${BOLD}Public key:${RESET}"
        cat "$key_path.pub"
        echo -e "${GRAY}(This is the public key you can add to authorized_keys on servers)${RESET}"
    fi
  else
    print_status error "SSH key generation failed. Check ssh-keygen output."
    return 1
  fi
  return 0
}

# Function to get metadata about the key
get_key_metadata() {
  local key_path="$1"
  
  # Verify the key exists
  if [ ! -f "$key_path" ]; then
    echo -e "${YELLOW}${BOLD}Error:${RESET} Key file not found: ${CYAN}$key_path${RESET}"
    return 1
  fi
  
  # Get the key type, size, and fingerprint
  local key_type key_size key_fp
  if [ -f "${key_path}.pub" ]; then
    # Use the public key if available
    key_type=$(ssh-keygen -l -f "${key_path}.pub" 2>/dev/null | awk '{print $3}' || echo "unknown")
    key_size=$(ssh-keygen -l -f "${key_path}.pub" 2>/dev/null | awk '{print $1}' || echo "unknown")
    key_fp=$(ssh-keygen -l -f "${key_path}.pub" 2>/dev/null | awk '{print $2}' || echo "")
  else
    # Try using the private key directly
    key_type=$(ssh-keygen -l -f "$key_path" 2>/dev/null | awk '{print $3}' || echo "unknown")
    key_size=$(ssh-keygen -l -f "$key_path" 2>/dev/null | awk '{print $1}' || echo "unknown")
    key_fp=$(ssh-keygen -l -f "$key_path" 2>/dev/null | awk '{print $2}' || echo "")
  fi
  
  # Return the data
  echo "type:$key_type"
  echo "size:$key_size"
  echo "fingerprint:$key_fp"
  
  return 0
}

# Function to check AWS credentials
check_aws_credentials() {
  local region="$1"
  debug_log "Checking AWS credentials in region: $region"
  
  if $DEBUG_MODE; then
    # Show the actual AWS command and output for debugging
    echo -e "${GRAY}Running: aws sts get-caller-identity --region \"$region\"${RESET}"
    if ! aws sts get-caller-identity --region "$region"; then
      echo -e "${YELLOW}${BOLD}Error:${RESET} AWS credentials not found or invalid. Run '${CYAN}aws configure${RESET}' to set them up." >&2
      return 1
    fi
  else
    # Silent mode for normal operation
    if ! aws sts get-caller-identity --region "$region" >/dev/null 2>&1; then
      echo -e "${YELLOW}${BOLD}Error:${RESET} AWS credentials not found or invalid. Run '${CYAN}aws configure${RESET}' to set them up." >&2
      echo -e "Try running with ${CYAN}--debug${RESET} for more information." >&2
      return 1
    fi
  fi
  
  debug_log "AWS credentials verified successfully"
  return 0
}

# Get the directory of the current script
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

# Function to manage environment
manage_environment() {
  echo -e "${BLUE}${BOLD}Managing SHH environment variables...${RESET}"
  
  # Check if shh-env exists and is executable
  if [ ! -x "$SCRIPT_DIR/shh-env" ]; then
    echo -e "${YELLOW}${BOLD}Error:${RESET} shh-env script not found or not executable."
    return 1
  fi
  
  # Run shh-env to manage environment
  "$SCRIPT_DIR/shh-env" "$@"
  
  # Re-export values after possible changes
  export SHH_SECRETS="${SHH_SECRETS:-$DEFAULT_SECRET_NAME}"
  export SHH_REGION="${SHH_REGION:-$DEFAULT_REGION}"
  export AWS_DEFAULT_REGION="${SHH_REGION:-$DEFAULT_REGION}"
  
  return 0
}

# Function to check required SHH environment variables
check_shh_environment() {
  local missing_vars=()
  
  # Check for SHH_SECRETS
  if [ -z "${SHH_SECRETS}" ]; then
    missing_vars+=("SHH_SECRETS")
  fi
  
  # Check for region from any of the possible sources
  if [ -z "${SHH_REGION}" ] && [ -z "${AWS_REGION}" ] && [ -z "${AWS_DEFAULT_REGION}" ]; then
    missing_vars+=("SHH_REGION")
  fi
  
  # If any required variables are missing
  if [ ${#missing_vars[@]} -gt 0 ]; then
    echo -e "${YELLOW}${BOLD}Error:${RESET} Required environment variable(s) not set: ${PINK}${missing_vars[*]}${RESET}" >&2
    echo -e "Would you like to configure these variables now using shh-admin? (y/n): " >&2
    read -r CONFIGURE
    
    if [[ "$CONFIGURE" =~ ^[Yy]$ ]]; then
      echo -e "${BLUE}Launching shh-admin environment configuration...${RESET}" >&2
      "$SCRIPT_DIR/shh-admin" --env
      exit 0
    else
      echo -e "Please run '${CYAN}shh-env${RESET}' or '${CYAN}shh-admin --env${RESET}' to configure your environment." >&2
      exit 1
    fi
  fi
}

# Parse arguments
if [ $# -lt 1 ]; then
  usage
fi

# Check for help flag
for arg in "$@"; do
  if [ "$arg" = "--help" ]; then
    usage
  fi
  if [ "$arg" = "--debug" ]; then
    DEBUG_MODE=true
  fi
  if [ "$arg" = "--generate" ]; then
    GENERATE_KEY=true
  fi
  if [ "$arg" = "--no-ssh-add" ]; then
    ADD_TO_AGENT=false
  fi
  if [ "$arg" = "--env" ]; then
    # Handle environment management and exit
    shift # Remove the script name from args
    manage_environment "$@"
    exit $?
  fi
  if [ "$arg" = "--user" ]; then
    USER_SCAN_MODE=true
  fi
done

# Parameters
FILE_PATH=""
# If not in user scan mode and not generating, expect a file path
if [ "$USER_SCAN_MODE" = false ] && [ "$GENERATE_KEY" = false ] && [ $# -gt 0 ]; then
  # Check if the first argument looks like an option, if so, user might have forgotten file path with --generate
  if [[ "$1" == --* ]]; then
    if [ "$GENERATE_KEY" = false ]; then # Only error if not in generate mode already
        print_status error "File path expected, but found option '$1'."
        print_status info "If generating a key, please use the --generate flag."
        usage
    fi
  else
FILE_PATH="$1"
    shift
  fi
fi

# Check for optional arguments
PROPERTY_NAME=""
REGION=""
UPLOAD_FP=true
ONLY_MODE=false
KEY_COMMENT="$(whoami)@$(hostname)"
KEY_PATH=""
USE_RAM_DISK=false

# Parse all arguments
while [ $# -gt 0 ]; do
  case "$1" in
    --generate)
      GENERATE_KEY=true
      shift
      ;;
    --type)
      if [ $# -lt 2 ]; then
        echo "Error: --type requires an argument"
        usage
      fi
      KEY_TYPE="$2"
      # Validate key type
      case "$KEY_TYPE" in
        ed25519|rsa|ecdsa|dsa)
          # Valid key type
          ;;
        *)
          echo "Error: Invalid key type. Must be one of: ed25519, rsa, ecdsa, dsa"
          exit 1
          ;;
      esac
      shift 2
      ;;
    --bits)
      if [ $# -lt 2 ]; then
        echo "Error: --bits requires an argument"
        usage
      fi
      KEY_BITS="$2"
      # Validate bits is a number
      if ! [[ "$KEY_BITS" =~ ^[0-9]+$ ]]; then
        echo "Error: --bits must be a number"
        exit 1
      fi
      shift 2
      ;;
    --rounds)
      if [ $# -lt 2 ]; then
        echo "Error: --rounds requires an argument"
        usage
      fi
      KEY_ROUNDS="$2"
      # Validate rounds is a number
      if ! [[ "$KEY_ROUNDS" =~ ^[0-9]+$ ]]; then
        echo "Error: --rounds must be a number"
        exit 1
      fi
      shift 2
      ;;
    --comment)
      if [ $# -lt 2 ]; then
        echo "Error: --comment requires an argument"
        usage
      fi
      KEY_COMMENT="$2"
      shift 2
      ;;
    --path)
      if [ $# -lt 2 ]; then
        echo "Error: --path requires an argument"
        usage
      fi
      KEY_PATH="$2"
      shift 2
      ;;
    --auto)
      AUTO_MODE=true
      shift
      ;;
    --shred)
      SHRED_KEY=true
      shift
      ;;
    --ram-disk)
      USE_RAM_DISK=true
      shift
      ;;
    --no-pub)
      UPLOAD_PUB=false
      shift
      ;;
    --only)
      ONLY_MODE=true
      UPLOAD_PUB=false
      UPLOAD_FP=false
      shift
      ;;
    --debug)
      DEBUG_MODE=true
      shift
      ;;
    --no-ssh-add)
      ADD_TO_AGENT=false
      shift
      ;;
    --user)
      USER_SCAN_MODE=true
      GENERATE_KEY=false
      FILE_PATH=""
      shift
      ;;
    --*)
      echo "Error: Unknown option '$1'"
      usage
      ;;
    *)
      if [ -z "$PROPERTY_NAME" ]; then
        PROPERTY_NAME="$1"
      elif [ -z "$REGION" ]; then
        REGION="$1"
      else
        echo "Error: Unexpected argument '$1'"
        usage
      fi
      shift
      ;;
  esac
done

# Check dependencies
check_dependencies

# Ensure AWS environment variables are set before proceeding
# This is common for all modes of operation that interact with AWS
check_shh_environment

if [ "$USER_SCAN_MODE" = true ]; then
  if [ "$GENERATE_KEY" = true ] || [ -n "$FILE_PATH" ]; then
    print_status error "The --user option cannot be used with --generate or a specific file path."
    usage
  fi
  # Placeholder for now, will call process_user_keys
  print_section "User SSH Key Import Mode"
  print_status info "Scanning ~/.ssh for keys (not yet implemented)..."
  # process_user_keys 
  process_user_keys # Actually call the function now
  exit 0
fi

# If generating a key (and not --user mode)
if [ "$GENERATE_KEY" = true ]; then
  # Create a path for the key if none specified
  if [ -z "$KEY_PATH" ]; then
    if [ "$USE_RAM_DISK" = true ]; then
      # Create a directory in RAM disk - enhanced with more options and better security
      if [ -d "/dev/shm" ]; then
        TEMP_DIR=$(mktemp -d /dev/shm/shh-XXXXXXXXXX)
        print_status secure "Using RAM disk for secure key generation at ${CYAN}$TEMP_DIR${RESET}"
        chmod 700 "$TEMP_DIR"
      elif [ -d "/run/user/$(id -u)" ]; then
        TEMP_DIR=$(mktemp -d "/run/user/$(id -u)/shh-XXXXXXXXXX")
        print_status secure "Using user runtime directory for secure key generation at ${CYAN}$TEMP_DIR${RESET}"
        chmod 700 "$TEMP_DIR"
      elif [ "$(uname)" = "Darwin" ] && [ -d "/private/tmp" ]; then
        TEMP_DIR=$(mktemp -d /private/tmp/shh-XXXXXXXXXX)
        print_status warning "RAM disk not available on macOS, using private temp directory at ${CYAN}$TEMP_DIR${RESET}"
        chmod 700 "$TEMP_DIR"
      else
        print_status warning "RAM disk not available at ${CYAN}/dev/shm${RESET} or other secure locations"
        echo -e "${WHITE}Using regular temporary directory instead.${RESET}"
        TEMP_DIR=$(mktemp -d)
        chmod 700 "$TEMP_DIR"
      fi
    else
      TEMP_DIR=$(mktemp -d)
      chmod 700 "$TEMP_DIR"
      debug_log "Using regular temporary directory: $TEMP_DIR"
    fi
    KEY_PATH="$TEMP_DIR/key"
    debug_log "Using temporary key path: $KEY_PATH"
  fi
  
  # Handle property name for key generation
  if [ -z "$PROPERTY_NAME" ]; then
    default_prop_name="$(whoami)_$KEY_TYPE"
    if [ "$AUTO_MODE" = true ]; then
      PROPERTY_NAME="$default_prop_name"
      debug_log "Auto-generated property name in --auto mode: $PROPERTY_NAME"
      print_status info "Using auto-generated key name: ${CYAN}$PROPERTY_NAME${RESET}"
    else
      print_section "Key Generation Setup"
      prompt_for_input "Enter a name for this key (default: $default_prop_name):" PROPERTY_NAME "$default_prop_name"
      if [ -z "$PROPERTY_NAME" ]; then
          PROPERTY_NAME="$default_prop_name"
      fi
      debug_log "Property name set to: $PROPERTY_NAME"
      print_status success "Key name set to: ${CYAN}$PROPERTY_NAME${RESET}"
    fi
  else
    # If property name was provided via command line, just confirm it
    if [ "$GENERATE_KEY" = true ]; then # Only print this if in generate mode
        print_section "Key Generation Setup"
        print_status info "Using provided key name: ${CYAN}$PROPERTY_NAME${RESET}"
    fi
  fi
  
  # Generate the key
  generate_ssh_key "$KEY_PATH" "$KEY_TYPE" "$KEY_BITS" "$KEY_ROUNDS" "$KEY_COMMENT"
  
  # Set the file path to the generated key
  FILE_PATH="$KEY_PATH"
else
  # Not generating a key - validate FILE_PATH exists
  if [ -z "$FILE_PATH" ]; then
    echo -e "${YELLOW}${BOLD}Error:${RESET} No file path provided."
    usage
  fi
  
if [ ! -f "$FILE_PATH" ]; then
    echo -e "${YELLOW}${BOLD}Error:${RESET} File '${CYAN}$FILE_PATH${RESET}' not found!"
    exit 1
  fi
fi

# Set defaults if not provided
PROPERTY_NAME="${PROPERTY_NAME:-$(basename "$FILE_PATH")}"
REGION="${REGION:-$DEFAULT_REGION}"
SECRET_NAME="${SHH_SECRETS:-$DEFAULT_SECRET_NAME}"

# Call the main key addition logic, unless in --user mode (which handles calls itself)
if [ "$USER_SCAN_MODE" = false ]; then
  if ! execute_add_key; then
    # Error messages are handled within execute_add_key
    print_status error "Key addition process failed for ${CYAN}${PROPERTY_NAME:-$FILE_PATH}${RESET}."
    # Cleanup trap will run, but exit explicitly with error
    exit 1
  fi

  # If we generated a key, provide information about it and shredding
  if [ "$GENERATE_KEY" = true ]; then
    print_section "Key Generation Summary & Cleanup"
    print_status success "Successfully generated and uploaded key '${CYAN}$PROPERTY_NAME${WHITE}' (type: ${CYAN}$KEY_TYPE${WHITE})"
    
    if [ "$SHRED_KEY" = true ]; then
      print_status secure "Key files in temporary location will be securely shredded upon script exit."
      # If a specific path was given with --generate --path, shred that too if --shred is on
      if [[ "$KEY_PATH" != "$TEMP_DIR/key" ]] && [ -n "$KEY_PATH" ]; then 
          print_status step "Securely shredding original key files at specified --path: ${CYAN}$KEY_PATH${RESET}..."
          secure_shred "$KEY_PATH"
          if [ -f "$KEY_PATH.pub" ]; then
            secure_shred "$KEY_PATH.pub"
          fi
      fi
    elif [ -n "$TEMP_DIR" ]; then # Key was generated in a temp dir and not shredded
      print_status key "Generated key located at: ${CYAN}$KEY_PATH${WHITE}"
      print_status warning "Consider securely shredding these files: ${CYAN}shred -uz $KEY_PATH $KEY_PATH.pub${RESET}"
    fi
    
    if [ "$USE_RAM_DISK" = true ] && [[ "$KEY_PATH" == /dev/shm/* || "$KEY_PATH" == /run/user/* ]]; then
      print_status secure "Key was generated in RAM disk and will not persist after reboot."
    fi
  fi
fi

exit 0
