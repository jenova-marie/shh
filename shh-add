#!/bin/bash

# Exit on errors
set -e

# Region priority: Command line > SHH_REGION > AWS_REGION > AWS_DEFAULT_REGION > default
DEFAULT_REGION=${SHH_REGION:-${AWS_REGION:-${AWS_DEFAULT_REGION:-"us-east-2"}}}
DEFAULT_SECRET_NAME=${SHH_SECRETS:-"testing-secrets"}
DEBUG_MODE=false
ADD_TO_AGENT=true  # Default to adding key to SSH agent
UPLOAD_PUB=true    # Default to uploading public key

# Function to display usage
usage() {
  echo "Usage: $(basename "$0") <file-path> [property-name] [region] [options]"
  echo ""
  echo "Arguments:"
  echo "  file-path      Path to the SSH key file"
  echo "  property-name  Name to store the key as (defaults to filename)"
  echo "  region         AWS region (defaults to $DEFAULT_REGION)"
  echo ""
  echo "Options:"
  echo "  --no-pub       Don't upload the public key (.pub) alongside the private key"
  echo "  --only         Only upload the specified file, skip public key and fingerprint"
  echo "  --debug        Enable verbose debugging output"
  echo "  --no-ssh-add   Don't add the key to the SSH agent"
  echo "  --env          Manage environment variables with shh-env"
  echo "  --help         Display this help message"
  echo ""
  echo "Environment variables (in order of precedence):"
  echo "  SHH_REGION           Preferred AWS region"
  echo "  AWS_REGION           Alternative AWS region"
  echo "  AWS_DEFAULT_REGION   Default AWS region"
  echo "  SHH_SECRETS          AWS Secrets Manager secret name"
  exit 1
}

# Function for debug logging
debug_log() {
  if $DEBUG_MODE; then
    echo "[DEBUG] $1"
  fi
}

# Check dependencies
check_dependencies() {
  local required_commands="aws jq base64 ssh-keygen"
  
  # Add ssh-agent commands if we're adding to SSH agent
  if [ "$ADD_TO_AGENT" = true ]; then
    required_commands="$required_commands ssh-add ssh-agent grep"
  fi
  
  for cmd in $required_commands; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
      echo "Error: Required command '$cmd' not found. Please install it." >&2
      exit 1
    fi
  done
}

# Function to check AWS credentials
check_aws_credentials() {
  local region="$1"
  debug_log "Checking AWS credentials in region: $region"
  
  if $DEBUG_MODE; then
    # Show the actual AWS command and output for debugging
    echo "Running: aws sts get-caller-identity --region \"$region\""
    if ! aws sts get-caller-identity --region "$region"; then
      echo "Error: AWS credentials not found or invalid. Run 'aws configure' to set them up." >&2
      return 1
    fi
  else
    # Silent mode for normal operation
    if ! aws sts get-caller-identity --region "$region" >/dev/null 2>&1; then
      echo "Error: AWS credentials not found or invalid. Run 'aws configure' to set them up." >&2
      echo "Try running with --debug for more information." >&2
      return 1
    fi
  fi
  
  debug_log "AWS credentials verified successfully"
  return 0
}

# Get the directory of the current script
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

# Function to manage environment
manage_environment() {
  echo "Managing SHH environment variables..."
  
  # Check if shh-env exists and is executable
  if [ ! -x "$SCRIPT_DIR/shh-env" ]; then
    echo "Error: shh-env script not found or not executable."
    return 1
  fi
  
  # Run shh-env to manage environment
  "$SCRIPT_DIR/shh-env" "$@"
  
  # Re-export values after possible changes
  export SHH_SECRETS="${SHH_SECRETS:-$DEFAULT_SECRET_NAME}"
  export SHH_REGION="${SHH_REGION:-$DEFAULT_REGION}"
  export AWS_DEFAULT_REGION="${SHH_REGION:-$DEFAULT_REGION}"
  
  return 0
}

# Parse arguments
if [ $# -lt 1 ]; then
  usage
fi

# Check for help flag
for arg in "$@"; do
  if [ "$arg" = "--help" ]; then
    usage
  fi
  if [ "$arg" = "--debug" ]; then
    DEBUG_MODE=true
  fi
  if [ "$arg" = "--no-ssh-add" ]; then
    ADD_TO_AGENT=false
  fi
  if [ "$arg" = "--env" ]; then
    # Handle environment management and exit
    shift # Remove the script name from args
    manage_environment "$@"
    exit $?
  fi
done

# Parameters
FILE_PATH="$1"
shift

# Check for optional arguments
PROPERTY_NAME=""
REGION=""
UPLOAD_FP=true
ONLY_MODE=false

while [ $# -gt 0 ]; do
  case "$1" in
    --no-pub)
      UPLOAD_PUB=false
      shift
      ;;
    --only)
      ONLY_MODE=true
      UPLOAD_PUB=false
      UPLOAD_FP=false
      shift
      ;;
    --debug)
      DEBUG_MODE=true
      shift
      ;;
    --no-ssh-add)
      ADD_TO_AGENT=false
      shift
      ;;
    --*)
      echo "Error: Unknown option '$1'"
      usage
      ;;
    *)
      if [ -z "$PROPERTY_NAME" ]; then
        PROPERTY_NAME="$1"
      elif [ -z "$REGION" ]; then
        REGION="$1"
      else
        echo "Error: Unexpected argument '$1'"
        usage
      fi
      shift
      ;;
  esac
done

# Set defaults if not provided
PROPERTY_NAME="${PROPERTY_NAME:-$(basename "$FILE_PATH")}"
REGION="${REGION:-$DEFAULT_REGION}"
SECRET_NAME="${SHH_SECRETS:-$DEFAULT_SECRET_NAME}"

# Export values for potential use by other scripts
export SHH_SECRETS="$SECRET_NAME"
export SHH_REGION="$REGION"
export AWS_DEFAULT_REGION="$REGION"

# Check dependencies
check_dependencies

# Ensure the file exists
if [ ! -f "$FILE_PATH" ]; then
  echo "Error: File '$FILE_PATH' not found!"
  exit 1
fi

# SECURITY CHECK: Verify user has access to the key by trying to add it to ssh-agent first
if [ "$ADD_TO_AGENT" = true ]; then
  echo "Verifying access to private key..."
  
  # Start ssh-agent if not running
  if ! pgrep -x "ssh-agent" >/dev/null 2>&1; then
    debug_log "Starting ssh-agent..."
    if $DEBUG_MODE; then
      eval "$(ssh-agent -s)"
    else
      eval "$(ssh-agent -s)" >/dev/null
    fi
  fi
  
  # Calculate fingerprint if public key is available for checking if already loaded
  SSH_KEY_FP=""
  if [ -f "$FILE_PATH.pub" ]; then
    SSH_KEY_FP=$(ssh-keygen -lf "$FILE_PATH.pub" 2>/dev/null | awk '{print $2}' || echo "")
    debug_log "Fingerprint: $SSH_KEY_FP"
    
    # Check if the key is already in ssh-agent using fingerprint
    if [ -n "$SSH_KEY_FP" ] && ssh-add -l 2>/dev/null | grep -q "$SSH_KEY_FP"; then
      debug_log "Key is already loaded in ssh-agent."
      echo "Key is already loaded in SSH agent."
    else
      # Try to add the key to ssh-agent to verify user has access
      debug_log "Attempting to add key to ssh-agent..."
      
      if ! ssh-add "$FILE_PATH" 2>/dev/null; then
        echo "Error: Failed to add key to SSH agent. You may not have permission to use this key." >&2
        echo "Please ensure you have the correct passphrase or permissions for this key before uploading." >&2
        exit 1
      fi
      
      echo "Successfully verified access to private key."
    fi
  else
    # No public key to check fingerprint, try to add directly
    debug_log "No public key found, attempting to add private key directly..."
    
    if ! ssh-add "$FILE_PATH" 2>/dev/null; then
      echo "Error: Failed to add key to SSH agent. You may not have permission to use this key." >&2
      echo "Please ensure you have the correct passphrase or permissions for this key before uploading." >&2
      exit 1
    fi
    
    echo "Successfully verified access to private key."
  fi
fi

# Now check AWS credentials
if ! check_aws_credentials "$REGION"; then
  exit 1
fi

echo "Using AWS Secret: $SECRET_NAME in region: $REGION"

# Retrieve the existing secret JSON from AWS Secrets Manager
debug_log "Attempting to get existing secret value..."
if ! EXISTING_SECRET=$(aws secretsmanager get-secret-value --secret-id "$SECRET_NAME" --region "$REGION" --query SecretString --output text 2>/dev/null); then
  echo "Secret '$SECRET_NAME' not found or access denied. Initializing new secret..."
  
  # Check if the secret exists but we don't have permission
  debug_log "Checking if secret exists but we lack permissions..."
  if aws secretsmanager describe-secret --secret-id "$SECRET_NAME" --region "$REGION" >/dev/null 2>&1; then
    echo "Error: Secret exists but you don't have permission to read it."
    exit 1
  fi
  
  # Try to create the secret using shh-admin
  echo "Attempting to create secret '$SECRET_NAME' using shh-admin..."
  
  # Prepare debug flag
  admin_debug_flag=""
  if $DEBUG_MODE; then
    admin_debug_flag="--debug"
  fi
  
  # Call shh-admin to create the secret
  if ! "$SCRIPT_DIR/shh-admin" --secret "$SECRET_NAME" --region "$REGION" --create $admin_debug_flag; then
    echo "Error: Failed to create secret '$SECRET_NAME' using shh-admin."
    exit 1
  fi
  
  # Now get the empty secret JSON
  if ! EXISTING_SECRET=$(aws secretsmanager get-secret-value --secret-id "$SECRET_NAME" --region "$REGION" --query SecretString --output text 2>/dev/null); then
    echo "Error: Failed to retrieve newly created secret '$SECRET_NAME'."
    exit 1
  fi
  
  debug_log "Initialized new secret with empty JSON object"
fi

# Base64 encode the file content
debug_log "Encoding file content from: $FILE_PATH"
ENCODED_FILE_CONTENT=$(base64 -w 0 < "$FILE_PATH")
debug_log "Encoded content length: ${#ENCODED_FILE_CONTENT} characters"

# Check if the property already exists in the secret
if echo "$EXISTING_SECRET" | jq -e --arg key "$PROPERTY_NAME" 'has($key)' >/dev/null; then
  echo "Property '$PROPERTY_NAME' already exists in secret '$SECRET_NAME'. Overwriting..."
else
  echo "Adding new property '$PROPERTY_NAME' to secret '$SECRET_NAME'."
fi

# Merge new property into existing JSON
debug_log "Merging property into existing secret JSON..."
UPDATED_SECRET=$(echo "$EXISTING_SECRET" | jq --arg key "$PROPERTY_NAME" --arg value "$ENCODED_FILE_CONTENT" '. + {($key): $value}')

# If not in --only mode and --pub is set, also upload the .pub file
if [ "$UPLOAD_PUB" = true ] && [ "$ONLY_MODE" = false ]; then
  PUB_FILE="$FILE_PATH.pub"
  if [ -f "$PUB_FILE" ]; then
    echo "Adding public key..."
    debug_log "Reading public key from: $PUB_FILE"
    ENCODED_PUB_CONTENT=$(cat "$PUB_FILE")
    UPDATED_SECRET=$(echo "$UPDATED_SECRET" | jq --arg key "$PROPERTY_NAME.pub" --arg value "$ENCODED_PUB_CONTENT" '. + {($key): $value}')
    echo "Public key '$PROPERTY_NAME.pub' added to secret."
  else
    echo "Warning: Public key file '$PUB_FILE' not found. Skipping upload."
  fi
fi

# Add or update metadata for the key
echo "Adding key metadata..."

# Get current timestamp in ISO 8601 format
TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
HOSTNAME=$(hostname)
USERNAME=$(whoami)
KEY_TYPE=$(ssh-keygen -l -f "$FILE_PATH" 2>/dev/null | awk '{print $3}' || echo "unknown")
KEY_SIZE=$(ssh-keygen -l -f "$FILE_PATH" 2>/dev/null | awk '{print $1}' || echo "unknown")
COMMENT=$(ssh-keygen -l -f "$FILE_PATH" 2>/dev/null | sed 's/^[^ ]* [^ ]* [^ ]* //' || echo "")

# Calculate fingerprint if public key is available
SSH_KEY_FP=""
if [ "$UPLOAD_FP" = true ] && [ "$ONLY_MODE" = false ]; then
  if [ -f "$FILE_PATH.pub" ]; then
    echo "Calculating SSH key fingerprint..."
    debug_log "Running ssh-keygen to calculate fingerprint"
    SSH_KEY_FP=$(ssh-keygen -lf "$FILE_PATH.pub" | awk '{print $2}')
    debug_log "Fingerprint: $SSH_KEY_FP"
  else
    echo "Warning: No public key file found for fingerprinting."
  fi
fi

# Check if there's existing metadata to update version
META_KEY="$PROPERTY_NAME.meta"
VERSION=1
CREATED_TIMESTAMP="$TIMESTAMP"
PREV_ROTATION_TIMESTAMP=""

# If metadata already exists, extract version and created timestamp
if echo "$EXISTING_SECRET" | jq -e --arg key "$META_KEY" 'has($key)' >/dev/null; then
  debug_log "Found existing metadata, updating version"
  EXISTING_META=$(echo "$EXISTING_SECRET" | jq -r --arg key "$META_KEY" '.[$key]')
  
  # Try to parse existing metadata as JSON
  if echo "$EXISTING_META" | jq . >/dev/null 2>&1; then
    # Extract previous version and increment
    PREV_VERSION=$(echo "$EXISTING_META" | jq -r '.version // 0')
    VERSION=$((PREV_VERSION + 1))
    
    # Keep original created date
    CREATED_TIMESTAMP=$(echo "$EXISTING_META" | jq -r '.created // "'$TIMESTAMP'"')
    
    # Save previous updated timestamp as rotation timestamp
    PREV_ROTATION_TIMESTAMP=$(echo "$EXISTING_META" | jq -r '.updated // ""')
  else
    debug_log "Existing metadata is not valid JSON, starting with version 1"
  fi
fi

# Calculate days until recommended rotation (90 days from now)
ROTATION_DUE_DATE=$(date -v+90d -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || date -d "+90 days" -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || echo "")

# Build metadata JSON using jq directly instead of here-doc + jq modifications
META_JSON_BASE=$(jq -n \
  --arg version "$VERSION" \
  --arg created "$CREATED_TIMESTAMP" \
  --arg updated "$TIMESTAMP" \
  --arg updater "$USERNAME@$HOSTNAME" \
  --arg key_type "$KEY_TYPE" \
  --arg key_size "$KEY_SIZE" \
  --arg comment "$COMMENT" \
  --arg rotation "$ROTATION_DUE_DATE" \
  '{
    "version": ($version | tonumber),
    "created": $created,
    "updated": $updated,
    "updated_by": $updater,
    "key_type": $key_type,
    "key_size": $key_size,
    "comment": $comment,
    "rotation_recommended": $rotation
  }')

# Add fingerprint to metadata if available
if [ -n "$SSH_KEY_FP" ]; then
  META_JSON_BASE=$(echo "$META_JSON_BASE" | jq --arg fp "$SSH_KEY_FP" '. + {"fingerprint": $fp}')
fi

# Add rotation history if this is not the first version
if [ -n "$PREV_ROTATION_TIMESTAMP" ] && [ "$VERSION" -gt 1 ]; then
  # Add last rotation timestamp
  META_JSON_BASE=$(echo "$META_JSON_BASE" | jq --arg ts "$PREV_ROTATION_TIMESTAMP" '. + {"last_rotation": $ts}')
  
  # Add rotation history tracking
  if echo "$EXISTING_META" | jq -e 'has("rotation_history")' >/dev/null 2>&1; then
    ROTATION_HISTORY=$(echo "$EXISTING_META" | jq '.rotation_history')
    
    # Add the last update to history
    ROTATION_ENTRY=$(jq -n --arg ts "$PREV_ROTATION_TIMESTAMP" --arg v "$PREV_VERSION" '{timestamp: $ts, version: ($v | tonumber)}')
    UPDATED_HISTORY=$(echo "$ROTATION_HISTORY" | jq --argjson entry "$ROTATION_ENTRY" '. + [$entry]' | jq 'sort_by(.timestamp) | reverse | .[0:10]')
  else
    # Create new history with just this entry
    ROTATION_ENTRY=$(jq -n --arg ts "$PREV_ROTATION_TIMESTAMP" --arg v "$PREV_VERSION" '{timestamp: $ts, version: ($v | tonumber)}')
    UPDATED_HISTORY=$(jq -n --argjson entry "$ROTATION_ENTRY" '[$entry]')
  fi
  
  # Add history to metadata
  META_JSON_BASE=$(echo "$META_JSON_BASE" | jq --argjson history "$UPDATED_HISTORY" '. + {rotation_history: $history}')
fi

# Convert metadata JSON to a string to store in the secret
META_JSON_STRING=$(echo "$META_JSON_BASE" | jq -c .)
debug_log "Generated metadata: $META_JSON_STRING"

# Add metadata to secret as a STRING value
UPDATED_SECRET=$(echo "$UPDATED_SECRET" | jq --arg key "$META_KEY" --arg value "$META_JSON_STRING" '. + {($key): $value}')
echo "Metadata for '$PROPERTY_NAME' added to secret (version $VERSION)."

# Check if we need to remove the old fingerprint property
# This helps with migration from previous versions of the script
FP_KEY="$PROPERTY_NAME.fp"
if echo "$UPDATED_SECRET" | jq -e --arg key "$FP_KEY" 'has($key)' >/dev/null; then
  debug_log "Removing deprecated fingerprint property '$FP_KEY'"
  UPDATED_SECRET=$(echo "$UPDATED_SECRET" | jq --arg key "$FP_KEY" 'del(.[$key])')
fi

# Store the updated JSON back in AWS Secrets Manager
echo "Updating secret in AWS Secrets Manager..."

# Create a temporary file for the secret JSON
TMP_JSON_FILE=$(mktemp)
echo "$UPDATED_SECRET" > "$TMP_JSON_FILE"

# Prepare debug flag for AWS CLI
aws_debug_flag=""
if $DEBUG_MODE; then
  aws_debug_flag="--debug"
  # Run with debugging enabled
  if ! aws secretsmanager put-secret-value \
       --secret-id "$SECRET_NAME" \
       --region "$REGION" \
       --secret-string file://"$TMP_JSON_FILE" \
       $aws_debug_flag; then
    rm -f "$TMP_JSON_FILE"
    echo "Error: Failed to update secret '$SECRET_NAME'. Check your AWS permissions."
    echo "Make sure you have the following IAM permissions for secret '$SECRET_NAME':"
    echo "  - secretsmanager:GetSecretValue"
    echo "  - secretsmanager:PutSecretValue"
    echo "  - secretsmanager:UpdateSecret"
    exit 1
  fi
else
  # Run without debug output
  if ! aws secretsmanager put-secret-value \
       --secret-id "$SECRET_NAME" \
       --region "$REGION" \
       --secret-string file://"$TMP_JSON_FILE" \
       > /dev/null 2>&1; then
    rm -f "$TMP_JSON_FILE"
    echo "Error: Failed to update secret '$SECRET_NAME'. Check your AWS permissions."
    echo "Make sure you have the following IAM permissions for secret '$SECRET_NAME':"
    echo "  - secretsmanager:GetSecretValue"
    echo "  - secretsmanager:PutSecretValue"
    echo "  - secretsmanager:UpdateSecret"
    exit 1
  fi
fi

# Clean up the temporary file
rm -f "$TMP_JSON_FILE"

echo "Successfully updated secret '$SECRET_NAME' with new property '$PROPERTY_NAME'."

exit 0
