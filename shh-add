#!/bin/bash

# Exit on errors
set -e

# ANSI color codes for pretty output
PINK="\033[38;5;206m"     # Hot pink for primary headings and parameter names
GREEN="\033[38;5;46m"     # Bright green for success messages
YELLOW="\033[38;5;220m"   # Yellow for warnings and important info
BLUE="\033[38;5;39m"      # Blue for option categories
CYAN="\033[38;5;87m"      # Cyan for options
WHITE="\033[97m"          # White for normal text
GRAY="\033[38;5;246m"     # Gray for descriptions
RED="\033[38;5;196m"      # Bright red for errors
PURPLE="\033[38;5;135m"   # Purple for special features
BOLD="\033[1m"            # Bold text
UNDERLINE="\033[4m"       # Underlined text
RESET="\033[0m"           # Reset all formatting

# Unicode symbols for indicators
CHECK_MARK="✓"
WARNING="⚠️"
ERROR_MARK="✗"
INFO_MARK="ℹ️"
ARROW="→"
LOCK="🔒"
KEY="🔑"

# Region priority: Command line > SHH_REGION > AWS_REGION > AWS_DEFAULT_REGION > default
DEFAULT_REGION=${SHH_REGION:-${AWS_REGION:-${AWS_DEFAULT_REGION:-"us-east-2"}}}
DEFAULT_SECRET_NAME=${SHH_SECRETS:-"testing-secrets"}
DEBUG_MODE=false
ADD_TO_AGENT=true  # Default to adding key to SSH agent
UPLOAD_PUB=true    # Default to uploading public key
GENERATE_KEY=false # Default to not generating a key
AUTO_MODE=false    # Default to interactive mode
KEY_TYPE="ed25519" # Default key type
KEY_BITS=4096      # Default bits for RSA keys
KEY_ROUNDS=100     # Default KDF rounds
SHRED_KEY=false    # Default to not shredding the key
TEMP_DIR=""        # Will be set later if needed
USER_SCAN_MODE=false # New flag for --user mode

# Function to print a boxed header
print_header() {
  local title="$1"
  local width=70
  local title_len=${#title}
  local padding=$(( (width - title_len - 2) / 2 ))
  local extra_space=$(( (width - title_len - 2) % 2 ))
  
  echo -e "${PINK}${BOLD}╔════════════════════════════════════════════════════════════════════╗${RESET}"
  printf "${PINK}${BOLD}║%*s%s%*s║${RESET}\n" $((padding + extra_space)) "" "$title" $padding ""
  echo -e "${PINK}${BOLD}╚════════════════════════════════════════════════════════════════════╝${RESET}"
}

# Function to display a status message
print_status() {
  local type="$1"
  local message="$2"
  
  case "$type" in
    success)
      echo -e "${GREEN}${BOLD}${CHECK_MARK} ${WHITE}${message}${RESET}"
      ;;
    warning)
      echo -e "${YELLOW}${BOLD}${WARNING} ${WHITE}${message}${RESET}"
      ;;
    error)
      echo -e "${RED}${BOLD}${ERROR_MARK} ${WHITE}${message}${RESET}"
      ;;
    info)
      echo -e "${BLUE}${BOLD}${INFO_MARK} ${WHITE}${message}${RESET}"
      ;;
    step)
      echo -e "${PURPLE}${BOLD}${ARROW} ${WHITE}${message}${RESET}"
      ;;
    secure)
      echo -e "${GREEN}${BOLD}${LOCK} ${WHITE}${message}${RESET}"
      ;;
    key)
      echo -e "${PINK}${BOLD}${KEY} ${WHITE}${message}${RESET}"
      ;;
  esac
}

# Function to print a section header
print_section() {
  local title="$1"
  local line_fill=$(printf "%*s" 50 "" | tr ' ' '─')
  echo -e "\n${BLUE}${BOLD}┌─ ${title} ${line_fill}${RESET}"
}

# Function to prompt for user input with colors
prompt_for_input() {
  local prompt_message="$1"
  local variable_name="$2"
  local default_value="${3:-}" # Optional default value

  echo -en "${PINK}${BOLD}${prompt_message}${RESET}${WHITE} "
  read -r user_input

  if [ -z "$user_input" ] && [ -n "$default_value" ]; then
    eval "$variable_name=\\"$default_value\\""
    echo -e "${GRAY}(used default: $default_value)${RESET}"
  else
    eval "$variable_name=\\"$user_input\\""
  fi
}

# Function to display usage
