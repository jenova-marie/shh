#!/bin/bash

# shh-install - Installer/Uninstaller script for the Shh toolkit
# This script installs or uninstalls the Shh tools for secure SSH key management with AWS Secrets Manager

set -e

# Get the directory of the current script
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

# Define colors for output
GREEN="\033[0;32m"
YELLOW="\033[1;33m"
RED="\033[0;31m"
BLUE="\033[0;34m"
NC="\033[0m" # No Color

# Repository URLs
SSH_REPO_URL="git@github.com:jenova-marie/shh.git"
HTTPS_REPO_URL="https://github.com/jenova-marie/shh.git"
INSTALL_DIR="/usr/local/share/shh"
BIN_DIR="/usr/local/bin"
LOG_FILE="/var/log/shh.log"
TEMP_DIR=$(mktemp -d)

# List of all executable scripts
SHH_EXECUTABLES=("shh" "shh-add" "shh-admin" "shh-env")

# Default action is install
ACTION="install"
# Flag to track if user has given consent
USER_CONSENT=false
# Default clone method (will be set by command line arguments or prompts)
CLONE_METHOD=""
# Flag for fully automated installation
AUTOMATED=false

# Helper function to handle user input with exit option
handle_user_input() {
  local input="$1"
  
  # Check if user wants to exit (x or X)
  if [[ "$input" =~ ^[Xx]$ ]]; then
    echo -e "${YELLOW}Installation canceled by user.${NC}"
    exit 0
  fi
}

# Function to check if we're running in an interactive terminal
is_interactive() {
  # Check if stdin is a terminal
  if [ -t 0 ]; then
    return 0  # True, running interactively
  else
    return 1  # False, not interactive (e.g., piped from curl)
  fi
}

# Function to get user input or use default in non-interactive mode
read_input() {
  local prompt="$1"
  local default="$2"
  local var_name="$3"
  
  # If in automated mode, just use the default without showing prompt
  if [ "$AUTOMATED" = true ]; then
    eval "$var_name=\"$default\""
    echo -e "$prompt${GREEN}$default${NC} ${YELLOW}(using default in automated mode)${NC}"
    return
  fi
  
  if is_interactive; then
    # Interactive mode - prompt user
    echo -e -n "$prompt"
    read -r "$var_name"
    
    # If empty input, use default
    if [ -z "${!var_name}" ]; then
      eval "$var_name=\"$default\""
    fi
  else
    # Non-interactive mode - use default and show what we're doing
    eval "$var_name=\"$default\""
    echo -e "$prompt${GREEN}$default${NC} ${YELLOW}(using default in non-interactive mode)${NC}"
  fi
}

# Print banner
print_banner() {
  echo -e "${BLUE}"
  echo "  ███████╗██╗  ██╗██╗  ██╗"
  echo "  ██╔════╝██║  ██║██║  ██║"
  echo "  ███████╗███████║███████║"
  echo "  ╚════██║██╔══██║██╔══██║"
  echo "  ███████║██║  ██║██║  ██║"
  echo "  ╚══════╝╚═╝  ╚═╝╚═╝  ╚═╝"
  echo ""
  echo "  Secretly Managing Your SSH Keys"
  if [ "$ACTION" = "uninstall" ]; then
    echo "  [UNINSTALL MODE]"
  fi
  echo -e "${NC}"
}

# Explain sudo usage and permissions
explain_sudo_usage() {
  echo -e "${BLUE}╔═══════════════════════════════════════════════╗${NC}"
  echo -e "${BLUE}║        ${YELLOW}Important Information About Permissions${BLUE}   ║${NC}"
  echo -e "${BLUE}╚═══════════════════════════════════════════════╝${NC}"
  echo -e "This script may require administrator privileges (sudo) to:"
  echo -e "  ${YELLOW}•${NC} Create the installation directory: ${BLUE}$INSTALL_DIR${NC}"
  echo -e "  ${YELLOW}•${NC} Create symlinks in: ${BLUE}$BIN_DIR${NC}"
  echo -e "  ${YELLOW}•${NC} Write to the log file: ${BLUE}$LOG_FILE${NC}"
  echo ""
  echo -e "${GREEN}Note:${NC} Sudo is only required for installation/uninstallation. The Shh tools themselves"
  echo -e "      do not require sudo privileges for normal operation."
  echo ""
  echo -e "All operations performed by this script are logged to: ${BLUE}$LOG_FILE${NC}"
  echo ""
  
  # If in automated mode, automatically continue
  if [ "$AUTOMATED" = true ]; then
    echo -e "${GREEN}✓ Proceeding automatically in automated mode...${NC}"
    USER_CONSENT=true
    log_message "Starting installation process in automated mode"
    return
  fi
  
  echo -e "${BLUE}╔═══════════════════════════════════════════════╗${NC}"
  echo -e "${BLUE}║                    ${YELLOW}Options${BLUE}                    ║${NC}"
  echo -e "${BLUE}╚═══════════════════════════════════════════════╝${NC}"
  echo -e "  ${GREEN}1${NC}) Continue with the installation (sudo password prompted when needed)"
  echo -e "  ${GREEN}2${NC}) Run with sudo upfront: ${BLUE}sudo curl -fsSL https://raw.githubusercontent.com/jenova-marie/shh/root/shh-install | sudo bash${NC}"
  echo -e "  ${GREEN}3${NC}) Review script first: ${BLUE}curl -fsSL https://raw.githubusercontent.com/jenova-marie/shh/root/shh-install | less${NC}"
  echo -e "  ${GREEN}X${NC}) Exit the script"
  echo ""
  
  # In non-interactive mode, default to yes
  read_input "Would you like to continue with the installation? [Y/n/x]: " "Y" "CONFIRM_INSTALL"
  
  # Handle exit option
  handle_user_input "$CONFIRM_INSTALL"
  
  if [[ "$CONFIRM_INSTALL" =~ ^[Nn]$ ]]; then
    echo -e "${YELLOW}⚠️ Installation canceled by user.${NC}"
    exit 0
  fi
  
  # User has consented to proceed
  USER_CONSENT=true
  
  # Now we can start logging
  echo -e "${BLUE}╔═══════════════════════════════════════════════╗${NC}"
  echo -e "${BLUE}║         ${GREEN}Starting Installation Process${BLUE}          ║${NC}"
  echo -e "${BLUE}╚═══════════════════════════════════════════════╝${NC}"
  log_message "Starting installation process..."
}

# Function to log messages with improved sudo transparency
log_message() {
  # Skip logging if user hasn't consented yet
  if [ "$USER_CONSENT" = false ]; then
    return
  fi
  
  local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
  local user=$(whoami)
  local host=$(hostname)
  local message="$1"
  
  # Create log message
  local log_entry="[$timestamp] [$user@$host] [$ACTION] $message"
  
  # Echo to console if not silent
  echo "$log_entry"
  
  # Append to log file, creating it if it doesn't exist
  if [ ! -f "$LOG_FILE" ]; then
    if [ ! -w "$(dirname "$LOG_FILE")" ]; then
      echo -e "${YELLOW}Sudo required:${NC} Creating log file at ${BLUE}$LOG_FILE${NC} (requires system directory access)"
      sudo touch "$LOG_FILE"
      sudo chmod 644 "$LOG_FILE"
    else
      touch "$LOG_FILE"
      chmod 644 "$LOG_FILE"
    fi
  fi
  
  # Write to log file
  if [ -w "$LOG_FILE" ]; then
    echo "$log_entry" >> "$LOG_FILE"
  else
    echo -e "${YELLOW}Sudo required:${NC} Writing to log file at ${BLUE}$LOG_FILE${NC} (requires system file access)"
    echo "$log_entry" | sudo tee -a "$LOG_FILE" >/dev/null
  fi
}

# Function to check for required commands
check_dependencies() {
  log_message "Checking dependencies..."
  
  local missing_deps=()
  for cmd in git aws jq ssh-agent; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
      missing_deps+=("$cmd")
    fi
  done
  
  if [ ${#missing_deps[@]} -gt 0 ]; then
    log_message "Error: The following required dependencies are missing:"
    for dep in "${missing_deps[@]}"; do
      log_message "  - $dep"
    done
    
    echo ""
    echo -e "${YELLOW}Please install the missing dependencies and run this script again.${NC}"
    exit 1
  fi
  
  log_message "All dependencies found!"
}

# Function to clone the repository, allowing user to choose between SSH and HTTPS
clone_repo() {
  log_message "Preparing to clone repository..."
  
  # If clone method was already specified via command line, use it directly
  if [ "$CLONE_METHOD" = "https" ]; then
    log_message "Using HTTPS clone method (specified via command line)"
    echo -e "${GREEN}✓ Using HTTPS to clone repository (as requested)...${NC}"
    if git clone "$HTTPS_REPO_URL" "$TEMP_DIR/shh"; then
      log_message "Repository cloned successfully using HTTPS!"
      return 0
    else
      log_message "Error: Failed to clone repository using HTTPS."
      echo -e "${RED}✗ Clone failed. Please check your network connection and repository access.${NC}"
      exit 1
    fi
  elif [ "$CLONE_METHOD" = "ssh" ]; then
    log_message "Using SSH clone method (specified via command line)"
    echo -e "${GREEN}✓ Using SSH to clone repository (as requested)...${NC}"
    if git clone "$SSH_REPO_URL" "$TEMP_DIR/shh"; then
      log_message "Repository cloned successfully using SSH!"
      return 0
    else
      log_message "Error: Failed to clone repository using SSH."
      echo -e "${RED}✗ SSH clone failed.${NC}"
      
      # Even with --ssh, offer HTTPS as fallback
      read_input "Would you like to try HTTPS instead? [Y/n/x]: " "Y" "TRY_HTTPS"
      
      # Handle exit option
      handle_user_input "$TRY_HTTPS"
      
      if [[ ! "$TRY_HTTPS" =~ ^[Nn]$ ]]; then
        log_message "Falling back to HTTPS after SSH failure"
        echo -e "${YELLOW}⚠️ Trying HTTPS clone instead...${NC}"
        if git clone "$HTTPS_REPO_URL" "$TEMP_DIR/shh"; then
          log_message "Repository cloned successfully using HTTPS!"
          return 0
        else
          log_message "Error: Failed to clone repository using either SSH or HTTPS."
          echo -e "${RED}✗ Clone failed with both SSH and HTTPS.${NC}"
          echo -e "  Please check your network connection and repository access."
          exit 1
        fi
      else
        log_message "User chose not to try HTTPS after SSH failure"
        echo -e "${YELLOW}⚠️ Clone operation canceled.${NC}"
        echo -e "  You may need to setup your SSH keys for GitHub."
        echo -e "  Visit: ${BLUE}https://docs.github.com/en/authentication/connecting-to-github-with-ssh${NC}"
        exit 1
      fi
    fi
  fi
  
  # If no clone method was specified, show options and prompt
  echo -e "${BLUE}╔═══════════════════════════════════════════════╗${NC}"
  echo -e "${BLUE}║           Repository Clone Options            ║${NC}"
  echo -e "${BLUE}╚═══════════════════════════════════════════════╝${NC}"
  echo -e "The script needs to download the latest code from GitHub:"
  echo ""
  echo -e "  ${GREEN}1${NC}) ${BLUE}SSH Clone${NC} (${SSH_REPO_URL})"
  echo -e "     ${YELLOW}•${NC} More secure and recommended for developers"
  echo -e "     ${YELLOW}•${NC} Requires SSH keys configured with GitHub"
  echo -e "     ${YELLOW}•${NC} May prompt for SSH key passphrase if protected"
  echo ""
  echo -e "  ${GREEN}2${NC}) ${BLUE}HTTPS Clone${NC} (${HTTPS_REPO_URL})"
  echo -e "     ${YELLOW}•${NC} Works without SSH key setup"
  echo -e "     ${YELLOW}•${NC} More reliable for automation"
  echo -e "     ${YELLOW}•${NC} No passphrase prompt required"
  echo ""
  echo -e "  ${GREEN}X${NC}) Exit the script"
  echo ""
  
  # In non-interactive mode, default to HTTPS clone (more reliable for automation)
  read_input "Which cloning method do you prefer? [1/2/x]: " "2" "CLONE_CHOICE"
  
  # Handle exit option
  handle_user_input "$CLONE_CHOICE"
  
  if [[ "$CLONE_CHOICE" == "2" ]]; then
    log_message "User selected HTTPS cloning"
    echo -e "${GREEN}✓ Using HTTPS to clone repository...${NC}"
    if git clone "$HTTPS_REPO_URL" "$TEMP_DIR/shh"; then
      log_message "Repository cloned successfully using HTTPS!"
      return 0
    else
      log_message "Error: Failed to clone repository using HTTPS."
      echo -e "${RED}✗ Clone failed. Please check your network connection and repository access.${NC}"
      exit 1
    fi
  elif [[ "$CLONE_CHOICE" == "1" ]] || [[ -z "$CLONE_CHOICE" ]]; then
    # Default or explicit choice for SSH
    log_message "User selected SSH cloning"
    echo -e "${GREEN}✓ Using SSH to clone repository...${NC}"
    echo -e "${YELLOW}⚠️ This may prompt for your SSH key passphrase if protected${NC}"
    if git clone "$SSH_REPO_URL" "$TEMP_DIR/shh"; then
      log_message "Repository cloned successfully using SSH!"
      return 0
    else
      echo -e "${RED}✗ SSH clone failed.${NC}"
      
      # In non-interactive mode, default to trying HTTPS
      read_input "Would you like to try HTTPS instead? [Y/n/x]: " "Y" "TRY_HTTPS"
      
      # Handle exit option
      handle_user_input "$TRY_HTTPS"
      
      if [[ ! "$TRY_HTTPS" =~ ^[Nn]$ ]]; then
        log_message "Falling back to HTTPS after SSH failure"
        echo -e "${YELLOW}⚠️ Trying HTTPS clone instead...${NC}"
        if git clone "$HTTPS_REPO_URL" "$TEMP_DIR/shh"; then
          log_message "Repository cloned successfully using HTTPS!"
          return 0
        else
          log_message "Error: Failed to clone repository using either SSH or HTTPS."
          echo -e "${RED}✗ Clone failed with both SSH and HTTPS.${NC}"
          echo -e "  Please check your network connection and repository access."
          exit 1
        fi
      else
        log_message "User chose not to try HTTPS after SSH failure"
        echo -e "${YELLOW}⚠️ Clone operation canceled.${NC}"
        echo -e "  You may need to setup your SSH keys for GitHub."
        echo -e "  Visit: ${BLUE}https://docs.github.com/en/authentication/connecting-to-github-with-ssh${NC}"
        exit 1
      fi
    fi
  else
    # Invalid choice
    echo -e "${RED}✗ Invalid option '${CLONE_CHOICE}'. Please select 1 or 2.${NC}"
    echo -e "${YELLOW}⚠️ Installation canceled.${NC}"
    exit 1
  fi
}

# Function to create the installation directory with appropriate permissions
create_install_directory() {
  if [ ! -d "$INSTALL_DIR" ]; then
    if [ ! -w "$(dirname "$INSTALL_DIR")" ]; then
      log_message "Requesting sudo permissions to create $INSTALL_DIR (current user lacks write permission)"
      echo -e "${YELLOW}Sudo required:${NC} Creating installation directory at ${BLUE}$INSTALL_DIR${NC}"
      if ! sudo mkdir -p "$INSTALL_DIR"; then
        log_message "Error: Failed to create installation directory."
        exit 1
      fi
      # Change ownership to make it writable
      sudo chown "$(id -u):$(id -g)" "$INSTALL_DIR"
      log_message "Created installation directory with sudo"
    else
      mkdir -p "$INSTALL_DIR"
      log_message "Created installation directory"
    fi
  fi
}

# Function to install the application
install_application() {
  log_message "Installing Shh application to ${INSTALL_DIR}..."
  
  # Create installation directory with appropriate permissions
  create_install_directory
  
  # Copy all files from the repository to the installation directory
  cp -r "$TEMP_DIR/shh/"* "$INSTALL_DIR/"
  log_message "Copied application files to $INSTALL_DIR"
  
  # Make scripts executable
  for script in "${SHH_EXECUTABLES[@]}"; do
    if [ -f "$INSTALL_DIR/$script" ]; then
      chmod +x "$INSTALL_DIR/$script"
      log_message "Made $script executable"
    else
      log_message "Warning: $script not found in installation files"
    fi
  done
  
  log_message "Application installed successfully to ${INSTALL_DIR}!"
}

# Function to create symlinks
create_symlinks() {
  log_message "Creating symlinks in ${BIN_DIR}..."
  
  # Check if we need sudo for the bin directory
  local use_sudo=false
  if [ ! -w "$BIN_DIR" ]; then
    use_sudo=true
    log_message "Requesting sudo permissions to create symlinks in $BIN_DIR (current user lacks write permission)"
    echo -e "${YELLOW}Sudo required:${NC} Creating symlinks in system directory ${BLUE}$BIN_DIR${NC}"
  fi
  
  # Create symlinks for each executable
  for cmd in "${SHH_EXECUTABLES[@]}"; do
    if [ -f "$INSTALL_DIR/$cmd" ]; then
      # Remove existing symlink or file if present
      if [ -L "$BIN_DIR/$cmd" ] || [ -f "$BIN_DIR/$cmd" ]; then
        if $use_sudo; then
          sudo rm -f "$BIN_DIR/$cmd"
        else
          rm -f "$BIN_DIR/$cmd"
        fi
        log_message "Removed existing $BIN_DIR/$cmd"
      fi
      
      # Create new symlink
      if $use_sudo; then
        if ! sudo ln -s "$INSTALL_DIR/$cmd" "$BIN_DIR/$cmd"; then
          log_message "Error: Failed to create symlink for $cmd."
          exit 1
        fi
      else
        if ! ln -s "$INSTALL_DIR/$cmd" "$BIN_DIR/$cmd"; then
          log_message "Error: Failed to create symlink for $cmd."
          exit 1
        fi
      fi
      log_message "Created symlink for $cmd"
    else
      log_message "Warning: Cannot create symlink for $cmd, source file not found"
    fi
  done
  
  log_message "Symlinks created successfully!"
}

# Function to clean up temporary files
cleanup() {
  log_message "Cleaning up temporary files..."
  rm -rf "$TEMP_DIR"
  log_message "Temporary files removed"
}

# Function to detect all installed shh executables
detect_installed_executables() {
  log_message "Detecting installed Shh executables..."
  local installed_execs=()
  
  # Check for expected executables by pattern in BIN_DIR
  for file in "$BIN_DIR"/shh*; do
    if [ -L "$file" ] || [ -f "$file" ]; then
      basename=$(basename "$file")
      installed_execs+=("$basename")
      log_message "Found installed executable: $basename"
    fi
  done
  
  # Also check installation directory
  if [ -d "$INSTALL_DIR" ]; then
    for file in "$INSTALL_DIR"/shh*; do
      if [ -x "$file" ] && [ -f "$file" ]; then
        basename=$(basename "$file")
        # Only add if not already in the list
        if ! [[ " ${installed_execs[*]} " =~ " ${basename} " ]]; then
          installed_execs+=("$basename")
          log_message "Found additional executable in install dir: $basename"
        fi
      fi
    done
  fi
  
  # Add default executables if none found (fallback)
  if [ ${#installed_execs[@]} -eq 0 ]; then
    log_message "No executables found, using default list"
    installed_execs=("${SHH_EXECUTABLES[@]}")
  fi
  
  # Return the list
  echo "${installed_execs[@]}"
}

# Improved function to remove installation directory
remove_install_directory() {
  if [ -d "$INSTALL_DIR" ]; then
    log_message "Removing installation directory $INSTALL_DIR..."
    
    if [ ! -w "$(dirname "$INSTALL_DIR")" ] || [ ! -w "$INSTALL_DIR" ]; then
      echo -e "${YELLOW}Sudo required:${NC} Removing installation directory at ${BLUE}$INSTALL_DIR${NC}"
      if ! sudo rm -rf "$INSTALL_DIR"; then
        log_message "Error: Failed to remove installation directory."
        exit 1
      fi
    else
      if ! rm -rf "$INSTALL_DIR"; then
        log_message "Error: Failed to remove installation directory."
        exit 1
      fi
    fi
    
    log_message "Installation directory removed"
  else
    log_message "Installation directory $INSTALL_DIR not found."
  fi
}

# Function to uninstall the application
uninstall() {
  # Explain sudo usage for uninstallation
  echo -e "${BLUE}╔═══════════════════════════════════════════════╗${NC}"
  echo -e "${BLUE}║        ${RED}Uninstallation Information${BLUE}            ║${NC}"
  echo -e "${BLUE}╚═══════════════════════════════════════════════╝${NC}"
  echo -e "This uninstallation process may require administrator privileges (sudo) to:"
  echo -e "  ${YELLOW}•${NC} Remove symlinks from: ${BLUE}$BIN_DIR${NC}"
  echo -e "  ${YELLOW}•${NC} Remove the installation directory: ${BLUE}$INSTALL_DIR${NC}"
  echo ""
  echo -e "${GREEN}Note:${NC} Sudo is only required for uninstallation. The Shh tools themselves"
  echo -e "      do not require sudo privileges for normal operation."
  echo ""
  echo -e "All operations performed will be logged to: ${BLUE}$LOG_FILE${NC}"
  echo ""
  
  # User has consented to proceed with uninstallation
  USER_CONSENT=true
  
  echo -e "${BLUE}╔═══════════════════════════════════════════════╗${NC}"
  echo -e "${BLUE}║          ${RED}Beginning Uninstallation${BLUE}            ║${NC}"
  echo -e "${BLUE}╚═══════════════════════════════════════════════╝${NC}"
  log_message "Beginning uninstallation of Shh..."
  
  # Detect all installed executables
  local detected_execs=()
  IFS=' ' read -r -a detected_execs <<< "$(detect_installed_executables)"
  
  # Remove symlinks
  log_message "Removing symlinks from $BIN_DIR..."
  local use_sudo=false
  if [ ! -w "$BIN_DIR" ]; then
    use_sudo=true
    echo -e "${YELLOW}Sudo required:${NC} Removing symlinks from system directory ${BLUE}$BIN_DIR${NC}"
    log_message "Requesting sudo permissions to remove symlinks from $BIN_DIR (current user lacks write permission)"
  fi
  
  for cmd in "${detected_execs[@]}"; do
    if [ -L "$BIN_DIR/$cmd" ]; then
      if $use_sudo; then
        sudo rm -f "$BIN_DIR/$cmd"
      else
        rm -f "$BIN_DIR/$cmd"
      fi
      log_message "Removed symlink $BIN_DIR/$cmd"
      echo -e "${GREEN}✓ Removed symlink:${NC} ${BLUE}$BIN_DIR/$cmd${NC}"
    elif [ -f "$BIN_DIR/$cmd" ]; then
      log_message "Warning: $BIN_DIR/$cmd exists but is not a symlink. Skipping."
      echo -e "${YELLOW}⚠️ Warning:${NC} ${BLUE}$BIN_DIR/$cmd${NC} exists but is not a symlink. Skipping."
    fi
  done
  
  # Remove installation directory
  remove_install_directory
  
  # Clean up shell config files
  echo -e "${BLUE}╔═══════════════════════════════════════════════╗${NC}"
  echo -e "${BLUE}║        ${YELLOW}Environment Variable Cleanup${BLUE}          ║${NC}"
  echo -e "${BLUE}╚═══════════════════════════════════════════════╝${NC}"
  log_message "Checking for Shh environment variables in shell config files..."
  
  local found_env_vars=false
  
  for config_file in "$HOME/.bashrc" "$HOME/.bash_profile" "$HOME/.zshrc" "$HOME/.profile"; do
    if [ -f "$config_file" ] && grep -q "SHH_" "$config_file"; then
      found_env_vars=true
      echo -e "${YELLOW}⚠️ Found Shh environment variables in:${NC} ${BLUE}$config_file${NC}"
      
      # In non-interactive mode, default to No (safer)
      read_input "Would you like to remove them? [y/N] " "N" "CONFIRM_ENV"
      
      if [[ "$CONFIRM_ENV" =~ ^[Yy]$ ]]; then
        # Create backup
        cp "$config_file" "$config_file.shh-backup.$(date +%Y%m%d%H%M%S)"
        log_message "Created backup of $config_file"
        echo -e "${GREEN}✓ Created backup:${NC} ${BLUE}$config_file.shh-backup.$(date +%Y%m%d%H%M%S)${NC}"
        
        # Remove SHH_ environment variables
        sed -i.bak '/^export SHH_/d' "$config_file"
        sed -i.bak '/^# SHH environment variables/d' "$config_file"
        rm -f "$config_file.bak"
        log_message "Removed Shh environment variables from $config_file"
        echo -e "${GREEN}✓ Removed Shh environment variables from:${NC} ${BLUE}$config_file${NC}"
      fi
    fi
  done
  
  if [ "$found_env_vars" = false ]; then
    echo -e "${GREEN}✓ No environment variables found in shell configuration files.${NC}"
  fi
  
  echo -e "${BLUE}╔═══════════════════════════════════════════════╗${NC}"
  echo -e "${BLUE}║        ${GREEN}Uninstallation Complete!${BLUE}             ║${NC}"
  echo -e "${BLUE}╚═══════════════════════════════════════════════╝${NC}"
  log_message "Uninstallation completed successfully!"
}

