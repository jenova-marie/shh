# Parse command line arguments before main execution
parse_arguments() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      install)
        ACTION="install"
        shift
        ;;
      uninstall)
        ACTION="uninstall"
        shift
        ;;
      --ssh)
        CLONE_METHOD="ssh"
        shift
        ;;
      --https)
        CLONE_METHOD="https"
        shift
        ;;
      --auto)
        AUTOMATED=true
        shift
        ;;
      help|--help|-h)
        show_usage
        ;;
      *)
        echo -e "${RED}Unknown option: $1${NC}"
        show_usage
        ;;
    esac
  done
}

# Handle passed arguments
# Convert -- style parameters that might be passed from bash -s
if [[ "$*" == *"--"* ]]; then
  ARGS=()
  PROCESSING_DOUBLE_DASH=false
  for ARG in "$@"; do
    if [[ "$ARG" == "--" ]]; then
      PROCESSING_DOUBLE_DASH=true
      continue
    fi
    
    if $PROCESSING_DOUBLE_DASH; then
      ARGS+=("$ARG")
    else
      ARGS+=("$ARG")
    fi
  done
  parse_arguments "${ARGS[@]}"
else
  parse_arguments "$@"
fi

