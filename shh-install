# Function to configure with shh-admin
configure_with_admin() {
  if [ "$ACTION" = "install" ]; then
    echo ""
    echo -e "${BLUE}╔═══════════════════════════════════════════════╗${NC}"
    echo -e "${BLUE}║          ${GREEN}Automatic Configuration${BLUE}             ║${NC}"
    echo -e "${BLUE}╚═══════════════════════════════════════════════╝${NC}"
    echo -e "Would you like to configure AWS Secrets Manager now? This will:"
    echo -e "  ${YELLOW}•${NC} Setup required environment variables"
    echo -e "  ${YELLOW}•${NC} Create or access your AWS Secrets Manager secret"
    echo -e "  ${YELLOW}•${NC} Test your AWS credentials and permissions"
    echo ""
    
    # In automated mode, automatically proceed with configuration
    if [ "$AUTOMATED" = true ]; then
      CONFIGURE_NOW="Y"
      echo -e "${GREEN}✓ Proceeding with automatic configuration...${NC}"
    else
      # In non-interactive mode or regular mode, ask
      read_input "Configure Shh now? [Y/n/x]: " "Y" "CONFIGURE_NOW"
      
      # Handle exit option
      handle_user_input "$CONFIGURE_NOW"
    fi
    
    if [[ ! "$CONFIGURE_NOW" =~ ^[Nn]$ ]]; then
      # First run shh-env directly for environment configuration
      echo -e "${GREEN}✓ Setting up environment variables...${NC}"
      # Use the scripts from the installation directory, not the system paths
      if [ -x "$INSTALL_DIR/shh-env" ]; then
        if [ "$AUTOMATED" = true ]; then
          # In automated mode, use --reset to set defaults without interaction
          "$INSTALL_DIR/shh-env" --reset
          echo -e "${GREEN}✓ Environment variables set to defaults${NC}"
        else
          "$INSTALL_DIR/shh-env" --menu
        fi
      else
        echo -e "${RED}✗ Error: Could not find shh-env in installation directory.${NC}"
        echo -e "  Current INSTALL_DIR is: ${BLUE}$INSTALL_DIR${NC}"
        return 1
      fi
      
      # Now ask if they want to also create/check their secret
      echo ""
      
      # In automated mode, automatically proceed with secret creation
      if [ "$AUTOMATED" = true ]; then
        VERIFY_SECRET="Y"
        echo -e "${GREEN}✓ Proceeding with automatic secret verification/creation...${NC}"
      else
        # In non-interactive mode or regular mode, ask
        read_input "Would you like to verify/create your AWS Secret? [Y/n/x]: " "Y" "VERIFY_SECRET"
        
        # Handle exit option
        handle_user_input "$VERIFY_SECRET"
      fi
      
      if [[ ! "$VERIFY_SECRET" =~ ^[Nn]$ ]]; then
        # Run shh-admin with create flag
        echo -e "${GREEN}✓ Running shh-admin to verify/create AWS Secret...${NC}"
        if [ -x "$INSTALL_DIR/shh-admin" ]; then
          "$INSTALL_DIR/shh-admin" -c
        else
          echo -e "${RED}✗ Error: Could not find shh-admin in installation directory.${NC}"
          echo -e "  Current INSTALL_DIR is: ${BLUE}$INSTALL_DIR${NC}"
          return 1
        fi
      else
        echo -e "${YELLOW}⚠️ You can run ${BLUE}shh-admin${NC} ${YELLOW}at any time to configure your AWS Secret.${NC}"
      fi
    else
      echo -e "${YELLOW}⚠️ You can run ${BLUE}shh-env${NC} and ${BLUE}shh-admin${NC} ${YELLOW}at any time to configure Shh.${NC}"
    fi
  fi
  
  # Final message to help users get started
  echo ""
  echo -e "${BLUE}╔═══════════════════════════════════════════════╗${NC}"
  echo -e "${BLUE}║             ${GREEN}What's Next?${BLUE}                      ║${NC}"
  echo -e "${BLUE}╚═══════════════════════════════════════════════╝${NC}"
  echo -e "Now that Shh is installed, here's how to get started:"
  echo ""
  echo -e "  ${YELLOW}1.${NC} Run ${BLUE}shh-admin${NC} to manage your AWS Secrets"
  echo -e "  ${YELLOW}2.${NC} Use ${BLUE}shh-add${NC} to add SSH keys to AWS Secrets Manager"
  echo -e "  ${YELLOW}3.${NC} Connect to servers with ${BLUE}shh user@host${NC}"
  echo ""
  echo -e "For more information, see the documentation with:"
  echo -e "  ${BLUE}curl -fsSL https://raw.githubusercontent.com/jenova-marie/shh/root/README.md | less${NC}"
  echo ""
}

