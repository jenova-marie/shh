#!/bin/bash

# Exit on error
set -e

# Default values
DEFAULT_REGION=${AWS_DEFAULT_REGION:-"us-east-2"}
DEFAULT_SECRET_NAME="ssh-keys"
DEBUG_MODE=false

# Function to display usage
usage() {
  echo "Usage: $(basename "$0") [options]"
  echo "Options:"
  echo "  -h, --help                 Display this help message"
  echo "  -d, --display              Display current environment configuration"
  echo "  -m, --menu                 Interactive menu to edit environment variables"
  echo "  -s, --set KEY=VALUE        Set an environment variable"
  echo "  -p, --persist              Persist environment to shell config"
  echo "  --reset                    Reset all SHH environment variables to defaults"
  echo "  --debug                    Enable verbose debugging output"
  echo ""
  echo "Examples:"
  echo "  $(basename "$0") --display              # Show current SHH environment"
  echo "  $(basename "$0") --set SHH_SECRETS=mysecrets   # Set secret name"
  echo "  $(basename "$0") --set SHH_REGION=us-west-2    # Set region"
  echo "  $(basename "$0") --set SHH_SECRETS=Test/X/123  # Set path-style secret"
  echo "  $(basename "$0") --persist              # Save settings to shell config"
  exit 1
}

# Function for debug logging
debug_log() {
  if $DEBUG_MODE; then
    echo "[DEBUG] $1"
  fi
}

# Function to detect shell and config file
detect_shell_config() {
  local shell
  shell=$(basename "$SHELL")
  
  debug_log "Detected shell: $shell"
  
  case "$shell" in
    bash)
      if [ -f "$HOME/.bashrc" ]; then
        echo "$HOME/.bashrc"
      elif [ -f "$HOME/.bash_profile" ]; then
        echo "$HOME/.bash_profile"
      else
        echo "$HOME/.profile"
      fi
      ;;
    zsh)
      echo "$HOME/.zshrc"
      ;;
    *)
      # Fallback for other shells
      if [ -f "$HOME/.profile" ]; then
        echo "$HOME/.profile"
      else
        echo ""
      fi
      ;;
  esac
}

# Function to display current environment
display_env() {
  echo "Current SHH Environment Configuration:"
  echo "-------------------------------------"
  echo "SHH_REGION:   ${SHH_REGION:-"<not set, using ${AWS_REGION:-${AWS_DEFAULT_REGION:-$DEFAULT_REGION}} (default)"}"
  echo "SHH_SECRETS:  ${SHH_SECRETS:-"<not set, using $DEFAULT_SECRET_NAME (default)"}"
  echo "SHH_DEBUG:    ${SHH_DEBUG:-"<not set, defaulting to false>"}"
  echo ""
}

# Function to set an environment variable
set_env_var() {
  local key_value="$1"
  local key="${key_value%%=*}"
  local value="${key_value#*=}"
  
  # Validate key starts with SHH_
  if [[ ! "$key" =~ ^SHH_ ]]; then
    echo "Error: Only SHH_ prefixed variables can be managed with this tool."
    echo "Received: $key"
    return 1
  fi
  
  # Set the variable in the current session
  export "$key"="$value"
  echo "Set $key=$value for current session"
  
  return 0
}

# Function to persist environment to shell config
persist_env() {
  local config_file
  config_file=$(detect_shell_config)
  
  if [ -z "$config_file" ]; then
    echo "Error: Could not detect shell configuration file."
    return 1
  fi
  
  echo "Shell config file: $config_file"
  
  # Create backup
  cp "$config_file" "$config_file.shh-backup.$(date +%Y%m%d%H%M%S)"
  echo "Created backup: $config_file.shh-backup.$(date +%Y%m%d%H%M%S)"
  
  # Remove existing SHH_ entries
  debug_log "Removing existing SHH_ entries"
  sed -i.bak '/^export SHH_/d' "$config_file"
  
  # Add current SHH_ variables
  echo "" >> "$config_file"
  echo "# SHH environment variables - Updated $(date)" >> "$config_file"
  
  # Only add variables that are actually set
  if [ -n "${SHH_REGION:-}" ]; then
    echo "export SHH_REGION=\"$SHH_REGION\"" >> "$config_file"
  fi
  
  if [ -n "${SHH_SECRETS:-}" ]; then
    echo "export SHH_SECRETS=\"$SHH_SECRETS\"" >> "$config_file"
  fi
  
  if [ -n "${SHH_DEBUG:-}" ]; then
    echo "export SHH_DEBUG=\"$SHH_DEBUG\"" >> "$config_file"
  fi
  
  echo "Updated $config_file with current SHH environment variables."
  echo "Please run 'source $config_file' to apply changes to your current session."
  
  return 0
}

# Function to reset environment variables
reset_env() {
  # Unset all SHH_ variables
  unset SHH_REGION
  unset SHH_SECRETS
  unset SHH_DEBUG
  
  # Set defaults
  export SHH_REGION="$DEFAULT_REGION"
  export SHH_SECRETS="$DEFAULT_SECRET_NAME"
  export SHH_DEBUG="false"
  
  echo "Reset all SHH environment variables to defaults:"
  display_env
  
  return 0
}

# Helper function to convert string to uppercase
to_upper() {
  echo "$1" | tr '[:lower:]' '[:upper:]'
}

# Interactive menu for environment variables
interactive_menu() {
  local changes_made=false
  local exit_menu=false
  
  while [ "$exit_menu" = false ]; do
    clear
    echo "SHH Environment Configuration Menu"
    echo "=================================="
    echo ""
    display_env
    echo "Menu Options:"
    echo "1) Set SHH_REGION (current AWS region)"
    echo "2) Set SHH_SECRETS (AWS Secrets Manager secret name)"
    echo "3) Toggle SHH_DEBUG (currently: ${SHH_DEBUG:-false})"
    echo "S) Save changes to shell config"
    echo "R) Reset to defaults"
    echo "X) Exit"
    echo ""
    echo -n "Select an option [X]: "
    
    read -r choice
    choice=${choice:-X}
    choice=$(to_upper "$choice")
    
    case "$choice" in
      1)
        echo ""
        echo "Current SHH_REGION: ${SHH_REGION:-"<not set, using ${AWS_REGION:-${AWS_DEFAULT_REGION:-$DEFAULT_REGION}} (default)"}"
        if [ -n "${AWS_REGION:-}" ]; then
          echo -n "Set SHH_REGION to AWS_REGION value ($AWS_REGION)? (Y/n): "
          read -r use_aws_region
          use_aws_region=$(to_upper "$use_aws_region")
          if [[ -z "$use_aws_region" || "$use_aws_region" == "Y" ]]; then
            export SHH_REGION="$AWS_REGION"
            echo "Set SHH_REGION=$AWS_REGION"
            changes_made=true
          else
            echo -n "Enter new value for SHH_REGION [leave empty for default]: "
            read -r new_region
            if [ -n "$new_region" ]; then
              export SHH_REGION="$new_region"
              echo "Set SHH_REGION=$new_region"
              changes_made=true
            else
              echo "Keeping current value"
            fi
          fi
        else
          echo -n "Enter new value for SHH_REGION [leave empty for default]: "
          read -r new_region
          if [ -n "$new_region" ]; then
            export SHH_REGION="$new_region"
            echo "Set SHH_REGION=$new_region"
            changes_made=true
          else
            echo "Keeping current value"
          fi
        fi
        read -n 1 -s -r -p "Press any key to continue..."
        ;;
      2)
        echo ""
        echo "Current SHH_SECRETS: ${SHH_SECRETS:-"<not set, using $DEFAULT_SECRET_NAME (default)"}"
        echo -n "Enter new value for SHH_SECRETS [leave empty for default]: "
        read -r new_secret
        if [ -n "$new_secret" ]; then
          export SHH_SECRETS="$new_secret"
          echo "Set SHH_SECRETS=$new_secret"
          changes_made=true
        else
          echo "Keeping current value"
        fi
        read -n 1 -s -r -p "Press any key to continue..."
        ;;
      3)
        echo ""
        if [ "${SHH_DEBUG:-false}" = "true" ]; then
          export SHH_DEBUG="false"
          echo "SHH_DEBUG turned OFF"
        else
          export SHH_DEBUG="true"
          echo "SHH_DEBUG turned ON"
        fi
        changes_made=true
        read -n 1 -s -r -p "Press any key to continue..."
        ;;
      S)
        if $changes_made; then
          echo ""
          persist_env
          changes_made=false
        else
          echo ""
          echo "No changes made to persist."
        fi
        read -n 1 -s -r -p "Press any key to continue..."
        ;;
      R)
        echo ""
        reset_env
        changes_made=true
        read -n 1 -s -r -p "Press any key to continue..."
        ;;
      X)
        if $changes_made; then
          echo ""
          echo -n "You have unsaved changes. Save to shell config before exiting? (y/N): "
          read -r save_before_exit
          save_before_exit=$(to_upper "$save_before_exit")
          if [[ "$save_before_exit" == "Y" ]]; then
            persist_env
          fi
        fi
        exit_menu=true
        ;;
      *)
        echo "Invalid option. Please try again."
        read -n 1 -s -r -p "Press any key to continue..."
        ;;
    esac
  done
  
  return 0
}

# Parse command line arguments
if [ $# -eq 0 ]; then
  interactive_menu
  exit 0
fi

DO_DISPLAY=false
DO_PERSIST=false
DO_RESET=false
DO_MENU=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      ;;
    -d|--display)
      DO_DISPLAY=true
      shift
      ;;
    -m|--menu)
      DO_MENU=true
      shift
      ;;
    -s|--set)
      if [ -z "$2" ]; then
        echo "Error: --set requires an argument in the format KEY=VALUE"
        exit 1
      fi
      set_env_var "$2"
      shift 2
      ;;
    -p|--persist)
      DO_PERSIST=true
      shift
      ;;
    --reset)
      DO_RESET=true
      shift
      ;;
    --debug)
      DEBUG_MODE=true
      export SHH_DEBUG="true"
      shift
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage
      ;;
  esac
done

# Handle command flags
if $DO_RESET; then
  reset_env
fi

if $DO_DISPLAY; then
  display_env
fi

if $DO_MENU; then
  interactive_menu
fi

if $DO_PERSIST; then
  persist_env
fi

# If no specific action was requested, show the menu
if ! $DO_DISPLAY && ! $DO_RESET && ! $DO_PERSIST && ! $DO_MENU; then
  interactive_menu
fi

exit 0
