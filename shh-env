#!/bin/bash

# Exit on error
set -e

# Define colors for output
GREEN="\033[0;32m"
YELLOW="\033[1;33m"
RED="\033[0;31m"
BLUE="\033[0;34m"
NC="\033[0m" # No Color

# Default values
DEFAULT_REGION=${AWS_DEFAULT_REGION:-"us-east-2"}
DEFAULT_SECRET_NAME="ssh-keys"
DEBUG_MODE=false

# Function to display usage
usage() {
  echo "Usage: $(basename "$0") [options]"
  echo "Options:"
  echo "  -h, --help                 Display this help message"
  echo "  -d, --display              Display current environment configuration"
  echo "  -m, --menu                 Interactive menu to edit environment variables"
  echo "  -s, --set KEY=VALUE        Set an environment variable"
  echo "  -p, --persist              Persist environment to shell config"
  echo "  --reset                    Reset all SHH environment variables to defaults"
  echo "  --debug                    Enable verbose debugging output"
  echo ""
  echo "Examples:"
  echo "  $(basename "$0") --display              # Show current SHH environment"
  echo "  $(basename "$0") --set SHH_SECRETS=mysecrets   # Set secret name"
  echo "  $(basename "$0") --set SHH_REGION=us-west-2    # Set region"
  echo "  $(basename "$0") --set SHH_SECRETS=Test/X/123  # Set path-style secret"
  echo "  $(basename "$0") --persist              # Save settings to shell config"
  exit 1
}

# Function for debug logging
debug_log() {
  if $DEBUG_MODE; then
    echo "[DEBUG] $1"
  fi
}

# Function to detect shell and config file
detect_shell_config() {
  local shell
  shell=$(basename "$SHELL")
  
  debug_log "Detected shell: $shell"
  
  case "$shell" in
    bash)
      if [ -f "$HOME/.bashrc" ]; then
        echo "$HOME/.bashrc"
      elif [ -f "$HOME/.bash_profile" ]; then
        echo "$HOME/.bash_profile"
      else
        echo "$HOME/.profile"
      fi
      ;;
    zsh)
      echo "$HOME/.zshrc"
      ;;
    *)
      # Fallback for other shells
      if [ -f "$HOME/.profile" ]; then
        echo "$HOME/.profile"
      else
        echo ""
      fi
      ;;
  esac
}

# Function to display current environment
display_env() {
  echo -e "${BLUE}Current SHH Environment Configuration:${NC}"
  echo -e "${BLUE}-------------------------------------${NC}"
  
  # Display region with color
  echo -ne "SHH_REGION:   "
  if [ -n "${SHH_REGION:-}" ]; then
    echo -e "${GREEN}$SHH_REGION${NC}"
  else
    echo -e "${YELLOW}<not set, using ${AWS_REGION:-${AWS_DEFAULT_REGION:-${GREEN}$DEFAULT_REGION${YELLOW}}} (default)${NC}"
  fi
  
  # Display secrets with color
  echo -ne "SHH_SECRETS:  "
  if [ -n "${SHH_SECRETS:-}" ]; then
    echo -e "${GREEN}$SHH_SECRETS${NC}"
  else
    echo -e "${YELLOW}<not set, using ${GREEN}$DEFAULT_SECRET_NAME${YELLOW} (default)${NC}"
  fi
  
  # Display debug with color
  echo -ne "SHH_DEBUG:    "
  if [ -n "${SHH_DEBUG:-}" ]; then
    if [ "${SHH_DEBUG}" = "true" ]; then
      echo -e "${GREEN}true${NC}"
    else
      echo -e "${RED}false${NC}"
    fi
  else
    echo -e "${YELLOW}<not set, defaulting to ${RED}false${YELLOW}>${NC}"
  fi
  
  echo ""
}

# Function to set an environment variable
set_env_var() {
  local key_value="$1"
  local key="${key_value%%=*}"
  local value="${key_value#*=}"
  
  # Validate key starts with SHH_
  if [[ ! "$key" =~ ^SHH_ ]]; then
    echo "Error: Only SHH_ prefixed variables can be managed with this tool."
    echo "Received: $key"
    return 1
  fi
  
  # Set the variable in the current session
  export "$key"="$value"
  echo "Set $key=$value for current session"
  
  return 0
}

# Function for guided configuration walkthrough
guided_config() {
  local changes_made=false
  
  echo ""
  echo -e "${BLUE}╔═══════════════════════════════════════╗${NC}"
  echo -e "${BLUE}║      Guided Configuration Wizard      ║${NC}"
  echo -e "${BLUE}╚═══════════════════════════════════════╝${NC}"
  echo -e "Let's set up your ${GREEN}Shh${NC} environment step by step."
  echo ""
  
  # Configure SHH_REGION
  echo -e "${BLUE}Step 1: AWS Region Configuration${NC}"
  echo -e "${BLUE}────────────────────────────────${NC}"
  
  echo -ne "Current SHH_REGION: "
  if [ -n "${SHH_REGION:-}" ]; then
    echo -e "${GREEN}$SHH_REGION${NC}"
  else
    echo -e "${YELLOW}<not set, using ${AWS_REGION:-${AWS_DEFAULT_REGION:-${GREEN}$DEFAULT_REGION${YELLOW}}} (default)${NC}"
  fi
  
  if [ -n "${AWS_REGION:-}" ]; then
    echo -e -n "Would you like to use AWS_REGION value (${GREEN}$AWS_REGION${NC})? [${GREEN}Y${NC}/n]: "
    read -r use_aws_region
    if [[ ! "$use_aws_region" =~ ^[Nn]$ ]]; then
      export SHH_REGION="$AWS_REGION"
      echo -e "✓ Set SHH_REGION=${GREEN}$AWS_REGION${NC}"
      changes_made=true
    else
      echo -e -n "Enter preferred AWS region [leave empty for ${GREEN}$DEFAULT_REGION${NC}]: "
      read -r new_region
      if [ -n "$new_region" ]; then
        export SHH_REGION="$new_region"
        echo -e "✓ Set SHH_REGION=${GREEN}$new_region${NC}"
        changes_made=true
      else
        echo -e "✓ Using default region: ${GREEN}$DEFAULT_REGION${NC}"
        export SHH_REGION="$DEFAULT_REGION"
        changes_made=true
      fi
    fi
  else
    echo -e -n "Enter preferred AWS region [leave empty for ${GREEN}$DEFAULT_REGION${NC}]: "
    read -r new_region
    if [ -n "$new_region" ]; then
      export SHH_REGION="$new_region"
      echo -e "✓ Set SHH_REGION=${GREEN}$new_region${NC}"
      changes_made=true
    else
      echo -e "✓ Using default region: ${GREEN}$DEFAULT_REGION${NC}"
      export SHH_REGION="$DEFAULT_REGION"
      changes_made=true
    fi
  fi
  
  echo ""
  
  # Configure SHH_SECRETS
  echo -e "${BLUE}Step 2: AWS Secrets Configuration${NC}"
  echo -e "${BLUE}───────────────────────────────${NC}"
  
  echo -ne "Current SHH_SECRETS: "
  if [ -n "${SHH_SECRETS:-}" ]; then
    echo -e "${GREEN}$SHH_SECRETS${NC}"
  else
    echo -e "${YELLOW}<not set, using ${GREEN}$DEFAULT_SECRET_NAME${YELLOW} (default)${NC}"
  fi
  
  echo -e -n "Enter name for your AWS Secret [leave empty for ${GREEN}$DEFAULT_SECRET_NAME${NC}]: "
  read -r new_secret
  if [ -n "$new_secret" ]; then
    export SHH_SECRETS="$new_secret"
    echo -e "✓ Set SHH_SECRETS=${GREEN}$new_secret${NC}"
    changes_made=true
  else
    echo -e "✓ Using default secret name: ${GREEN}$DEFAULT_SECRET_NAME${NC}"
    export SHH_SECRETS="$DEFAULT_SECRET_NAME"
    changes_made=true
  fi
  
  echo ""
  
  # Configure SHH_DEBUG
  echo -e "${BLUE}Step 3: Debug Mode Configuration${NC}"
  echo -e "${BLUE}──────────────────────────────${NC}"
  
  echo -ne "Debug mode: "
  if [ "${SHH_DEBUG:-false}" = "true" ]; then
    echo -e "${GREEN}enabled${NC}"
  else
    echo -e "${RED}disabled${NC}"
  fi
  
  echo -e -n "Enable debug mode? [y/${GREEN}N${NC}]: "
  read -r enable_debug
  if [[ "$enable_debug" =~ ^[Yy]$ ]]; then
    export SHH_DEBUG="true"
    echo -e "✓ Debug mode ${GREEN}enabled${NC}"
    changes_made=true
  else
    export SHH_DEBUG="false"
    echo -e "✓ Debug mode ${RED}disabled${NC}"
    changes_made=true
  fi
  
  echo ""
  echo -e "${BLUE}╔═══════════════════════════════════════╗${NC}"
  echo -e "${BLUE}║         Configuration Complete         ║${NC}"
  echo -e "${BLUE}╚═══════════════════════════════════════╝${NC}"
  
  # Prompt to save changes
  if $changes_made; then
    echo -e -n "Would you like to save these settings to your shell config? [${GREEN}Y${NC}/n]: "
    read -r save_config
    if [[ ! "$save_config" =~ ^[Nn]$ ]]; then
      local config_file=$(persist_env)
      
      # After persisting to shell config, ask if they want to apply to current shell
      echo -e -n "Would you like to apply these settings to your current shell? [${GREEN}Y${NC}/n]: "
      read -r apply_current
      if [[ ! "$apply_current" =~ ^[Nn]$ ]]; then
        create_source_output
      else
        echo -e "Please run '${BLUE}source $config_file${NC}' to apply changes to your current session."
      fi
    else
      echo -e "Settings applied for current session only."
      # Always create source output if not saving to config
      create_source_output
    fi
  fi
  
  return 0
}

# Function to create a sourceable output for immediate application
create_source_output() {
  local temp_file="/tmp/shh_env_vars_$(date +%s).sh"
  
  echo "#!/bin/bash" > "$temp_file"
  echo "" >> "$temp_file"
  echo "# SHH environment variables - Generated $(date)" >> "$temp_file"
  echo "" >> "$temp_file"
  
  # Only export variables that are actually set
  if [ -n "${SHH_REGION:-}" ]; then
    echo "export SHH_REGION=\"$SHH_REGION\"" >> "$temp_file"
  fi
  
  if [ -n "${SHH_SECRETS:-}" ]; then
    echo "export SHH_SECRETS=\"$SHH_SECRETS\"" >> "$temp_file"
  fi
  
  if [ -n "${SHH_DEBUG:-}" ]; then
    echo "export SHH_DEBUG=\"$SHH_DEBUG\"" >> "$temp_file"
  fi
  
  # Add AWS region variables if needed
  if [ -n "${SHH_REGION:-}" ] && [ -z "${AWS_REGION:-}" ]; then
    echo "export AWS_REGION=\"$SHH_REGION\"" >> "$temp_file"
  fi
  
  if [ -n "${SHH_REGION:-}" ] && [ -z "${AWS_DEFAULT_REGION:-}" ]; then
    echo "export AWS_DEFAULT_REGION=\"$SHH_REGION\"" >> "$temp_file"
  fi
  
  chmod +x "$temp_file"
  
  echo -e "${GREEN}✓ Environment variables ready for immediate use!${NC}"
  echo -e "${YELLOW}Run this command to apply them to your current shell:${NC}"
  echo -e ""
  echo -e "    ${BLUE}source $temp_file${NC}"
  echo -e ""
  echo -e "This will set the environment variables for your current shell session."
  
  return 0
}

# Function to persist environment to shell config
persist_env() {
  local config_file
  config_file=$(detect_shell_config)
  
  if [ -z "$config_file" ]; then
    echo -e "${RED}Error: Could not detect shell configuration file.${NC}"
    return 1
  fi
  
  echo -e "Shell config file: ${BLUE}$config_file${NC}"
  
  # Create backup
  cp "$config_file" "$config_file.shh-backup.$(date +%Y%m%d%H%M%S)"
  echo -e "Created backup: ${BLUE}$config_file.shh-backup.$(date +%Y%m%d%H%M%S)${NC}"
  
  # Remove existing SHH_ entries
  debug_log "Removing existing SHH_ entries"
  sed -i.bak '/^export SHH_/d' "$config_file"
  sed -i.bak '/^# SHH environment variables/d' "$config_file"
  rm -f "$config_file.bak"
  
  # Add current SHH_ variables
  echo "" >> "$config_file"
  echo "# SHH environment variables - Updated $(date)" >> "$config_file"
  
  # Only add variables that are actually set
  if [ -n "${SHH_REGION:-}" ]; then
    echo "export SHH_REGION=\"$SHH_REGION\"" >> "$config_file"
  fi
  
  if [ -n "${SHH_SECRETS:-}" ]; then
    echo "export SHH_SECRETS=\"$SHH_SECRETS\"" >> "$config_file"
  fi
  
  if [ -n "${SHH_DEBUG:-}" ]; then
    echo "export SHH_DEBUG=\"$SHH_DEBUG\"" >> "$config_file"
  fi
  
  echo -e "${GREEN}✓ Updated ${BLUE}$config_file${GREEN} with current SHH environment variables.${NC}"
  
  # Return the config file path
  echo "$config_file"
  
  return 0
}

# Interactive menu for environment variables - single selection, then exit
interactive_menu() {
  clear
  echo -e "${BLUE}╔═══════════════════════════════════════╗${NC}"
  echo -e "${BLUE}║     SHH Environment Configuration     ║${NC}"
  echo -e "${BLUE}╚═══════════════════════════════════════╝${NC}"
  echo ""
  display_env
  echo -e "${BLUE}Menu Options:${NC}"
  echo -e "${GREEN}1${NC}) Start Configuration Walkthrough"
  echo -e "${GREEN}2${NC}) Reset to defaults"
  echo -e "${GREEN}X${NC}) Exit"
  echo ""
  echo -e -n "Select an option [${GREEN}X${NC}]: "
  
  read -r choice
  choice=${choice:-X}
  choice=$(to_upper "$choice")
  
  case "$choice" in
    1)
      guided_config
      exit 0
      ;;
    2)
      echo ""
      reset_env
      
      # Prompt to save changes after reset
      echo -e -n "Would you like to save these settings to your shell config? [${GREEN}Y${NC}/n]: "
      read -r save_config
      if [[ ! "$save_config" =~ ^[Nn]$ ]]; then
        local config_file=$(persist_env)
        
        # After persisting to shell config, ask if they want to apply to current shell
        echo -e -n "Would you like to apply these settings to your current shell? [${GREEN}Y${NC}/n]: "
        read -r apply_current
        if [[ ! "$apply_current" =~ ^[Nn]$ ]]; then
          create_source_output
        else
          echo -e "Please run '${BLUE}source $config_file${NC}' to apply changes to your current session."
        fi
      else
        # Always create source output if not saving to config
        create_source_output
      fi
      exit 0
      ;;
    X)
      # Check if any configuration exists
      if [ -z "${SHH_REGION:-}" ] && [ -z "${SHH_SECRETS:-}" ]; then
        echo -e ""
        echo -e "${YELLOW}⚠️  Warning: No Shh configuration detected.${NC}"
        echo -e -n "Would you like to create a basic configuration now? [${GREEN}Y${NC}/n]: "
        read -r create_config
        if [[ ! "$create_config" =~ ^[Nn]$ ]]; then
          guided_config
        else
          echo -e "${YELLOW}⚠️  Exiting without configuration. Shh may not work correctly.${NC}"
        fi
      else
        # Configuration exists, just exit quietly
        echo -e "${GREEN}✓ Configuration exists. Exiting.${NC}"
      fi
      exit 0
      ;;
    *)
      echo -e "${RED}Invalid option. Please try again.${NC}"
      echo -e "Press Enter to return to the menu..."
      read -r
      interactive_menu  # This is the only place we return to the menu
      ;;
  esac
  
  # Should never reach here
  exit 0
}

# Function to reset environment variables
reset_env() {
  # Unset all SHH_ variables
  unset SHH_REGION
  unset SHH_SECRETS
  unset SHH_DEBUG
  
  # Set defaults
  export SHH_REGION="$DEFAULT_REGION"
  export SHH_SECRETS="$DEFAULT_SECRET_NAME"
  export SHH_DEBUG="false"
  
  echo -e "${GREEN}✓ Reset all SHH environment variables to defaults:${NC}"
  display_env
  
  return 0
}

# Helper function to convert string to uppercase
to_upper() {
  echo "$1" | tr '[:lower:]' '[:upper:]'
}

# Parse command line arguments
if [ $# -eq 0 ]; then
  interactive_menu
  exit 0
fi

DO_DISPLAY=false
DO_PERSIST=false
DO_RESET=false
DO_MENU=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      ;;
    -d|--display)
      DO_DISPLAY=true
      shift
      ;;
    -m|--menu)
      DO_MENU=true
      shift
      ;;
    -s|--set)
      if [ -z "$2" ]; then
        echo "Error: --set requires an argument in the format KEY=VALUE"
        exit 1
      fi
      set_env_var "$2"
      shift 2
      ;;
    -p|--persist)
      DO_PERSIST=true
      shift
      ;;
    --reset)
      DO_RESET=true
      shift
      ;;
    --debug)
      DEBUG_MODE=true
      export SHH_DEBUG="true"
      shift
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage
      ;;
  esac
done

# Handle command flags
if $DO_RESET; then
  reset_env
fi

if $DO_DISPLAY; then
  display_env
fi

if $DO_MENU; then
  interactive_menu
fi

if $DO_PERSIST; then
  persist_env
fi

# If no specific action was requested, show the menu
if ! $DO_DISPLAY && ! $DO_RESET && ! $DO_PERSIST && ! $DO_MENU; then
  interactive_menu
fi

exit 0
