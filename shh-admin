#!/bin/bash
set -e

# Region priority: Command line > SHH_REGION > AWS_REGION > AWS_DEFAULT_REGION > default
DEFAULT_REGION=${SHH_REGION:-${AWS_REGION:-${AWS_DEFAULT_REGION:-"us-east-2"}}}
DEFAULT_SECRET_NAME=${SHH_SECRETS:-"testing-secrets"}
DEBUG_MODE=false

# Function to display usage
usage() {
  echo "Usage: $(basename "$0") [options]"
  echo "Options:"
  echo "  -h, --help                Display this help message"
  echo "  -r, --region REGION       AWS region (default: $DEFAULT_REGION)"
  echo "  -s, --secret NAME         Secret name (default: $DEFAULT_SECRET_NAME)"
  echo "  -l, --list                List keys in the secret"
  echo "  -d, --detail KEY_NAME     Show details for a specific key"
  echo "  -c, --create              Create the secret if it doesn't exist, non-interactive mode"
  echo "  -e, --env                 Only manage environment variables without proceeding to AWS operations"
  echo "  --debug                   Enable verbose debugging output"
  echo ""
  echo "Environment variables (in order of precedence):"
  echo "  SHH_REGION           Preferred AWS region"
  echo "  AWS_REGION           Alternative AWS region"
  echo "  AWS_DEFAULT_REGION   Default AWS region"
  echo "  SHH_SECRETS          AWS Secrets Manager secret name"
  exit 1
}

# Function for debug logging
debug_log() {
  if $DEBUG_MODE; then
    echo "[DEBUG] $1"
  fi
}

# Get the directory of the current script
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

# Function to check if environment is properly configured
check_environment_configuration() {
  local missing_vars=()
  
  # Check for SHH_SECRETS
  if [ -z "${SHH_SECRETS}" ]; then
    missing_vars+=("SHH_SECRETS")
  fi
  
  # Check for region from any of the possible sources
  if [ -z "${SHH_REGION}" ] && [ -z "${AWS_REGION}" ] && [ -z "${AWS_DEFAULT_REGION}" ]; then
    missing_vars+=("SHH_REGION")
  fi
  
  # Return the number of missing variables
  echo ${#missing_vars[@]}
}

# Function to manage environment
manage_environment() {
  echo "Managing SHH environment variables..."
  
  # Check if shh-env exists and is executable
  local shh_env_path="$SCRIPT_DIR/shh-env"
  if [ ! -x "$shh_env_path" ]; then
    echo "Error: shh-env script not found or not executable at '$shh_env_path'."
    echo "Current SCRIPT_DIR is: $SCRIPT_DIR"
    return 1
  fi
  
  # Run shh-env directly with the menu flag for consistent UI
  # Always use explicit relative path from SCRIPT_DIR
  "$SCRIPT_DIR/shh-env" --menu
  
  # Environment variables should now be set by shh-env, export them to current session
  if [ -n "${SHH_REGION:-}" ]; then
    export SHH_REGION
    export AWS_DEFAULT_REGION="$SHH_REGION"
  fi
  
  if [ -n "${SHH_SECRETS:-}" ]; then
    export SHH_SECRETS
  fi
  
  if [ -n "${SHH_DEBUG:-}" ]; then
    export SHH_DEBUG
  fi
  
  return 0
}

# Function to provide detailed AWS IAM diagnostics and recommendations
provide_iam_diagnostics() {
  local secret_name="$1"
  local region="$2"
  local action="$3"
  
  echo "=== AWS IAM Diagnostics ==="
  echo "Problem detected: Unable to $action the secret '$secret_name' in region '$region'"
  echo ""
  
  # Check basic identity
  echo "Checking your AWS identity..."
  local identity
  if identity=$(aws sts get-caller-identity 2>/dev/null); then
    local account_id=$(echo "$identity" | jq -r '.Account')
    local user_arn=$(echo "$identity" | jq -r '.Arn')
    echo "You are authenticated as: $user_arn"
    echo "Account ID: $account_id"
  else
    echo "Error: Unable to get your AWS identity. Your credentials may be invalid or expired."
    echo "Run 'aws configure' to update your AWS credentials."
    return 1
  fi
  
  # Prepare the resource ARN pattern
  local resource_arn="arn:aws:secretsmanager:$region:$account_id:secret:$secret_name"
  
  # Add wildcard for path-style secrets
  if [[ "$secret_name" == */* ]]; then
    resource_arn="$resource_arn-*"
  else
    resource_arn="$resource_arn-*"
  fi
  
  echo ""
  echo "Required permissions:"
  echo "For managing secrets, you need the following IAM permissions:"
  
  case "$action" in
    "create")
      echo "- secretsmanager:CreateSecret"
      echo "- secretsmanager:PutSecretValue"
      echo "- secretsmanager:GetSecretValue"
      ;;
    "access")
      echo "- secretsmanager:GetSecretValue"
      echo "- secretsmanager:DescribeSecret"
      ;;
    "update")
      echo "- secretsmanager:PutSecretValue"
      echo "- secretsmanager:UpdateSecret"
      echo "- secretsmanager:GetSecretValue"
      ;;
    *)
      echo "- secretsmanager:CreateSecret"
      echo "- secretsmanager:GetSecretValue"
      echo "- secretsmanager:PutSecretValue"
      echo "- secretsmanager:UpdateSecret"
      echo "- secretsmanager:DescribeSecret"
      echo "- secretsmanager:ListSecrets"
      ;;
  esac
  
  echo ""
  echo "Suggested IAM policy to attach to your user/role:"
  echo ""
  echo '{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Action": [
                "secretsmanager:CreateSecret",
                "secretsmanager:GetSecretValue",
                "secretsmanager:PutSecretValue",
                "secretsmanager:UpdateSecret",
                "secretsmanager:DescribeSecret",
                "secretsmanager:ListSecrets"
            ],
            "Resource": "'"$resource_arn"'"
        }
    ]
}'
  
  echo ""
  echo "You can create this policy using the AWS CLI with:"
  local policy_name="ShhSecrets-$secret_name"
  policy_name=${policy_name//\//-} # Replace slashes with dashes for policy name
  
  echo ""
  echo "# 1. Create a policy JSON file"
  echo "cat > shh-policy.json << 'EOL'"
  echo '{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Action": [
                "secretsmanager:CreateSecret",
                "secretsmanager:GetSecretValue",
                "secretsmanager:PutSecretValue",
                "secretsmanager:UpdateSecret",
                "secretsmanager:DescribeSecret",
                "secretsmanager:ListSecrets"
            ],
            "Resource": "'"$resource_arn"'"
        }
    ]
}'
  echo "EOL"
  echo ""
  echo "# 2. Create the policy in AWS"
  echo "aws iam create-policy --policy-name $policy_name --policy-document file://shh-policy.json"
  echo ""
  echo "# 3. Attach the policy to your user (replace USERNAME with your IAM username)"
  echo "aws iam attach-user-policy --user-name USERNAME --policy-arn arn:aws:iam::$account_id:policy/$policy_name"
  echo ""
  echo "For security best practices, consider using more restrictive permissions appropriate for your use case."
}

# Check dependencies
check_dependencies() {
  for cmd in aws jq; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
      echo "Error: Required command '$cmd' not found. Please install it." >&2
      exit 1
    fi
  done
}

# Function to check AWS credentials
check_aws_credentials() {
  local region="$1"
  debug_log "Checking AWS credentials in region: $region"
  
  if $DEBUG_MODE; then
    # Show the actual AWS command and output for debugging
    echo "Running: aws sts get-caller-identity --region \"$region\""
    if ! aws sts get-caller-identity --region "$region"; then
      echo "Error: AWS credentials not found or invalid. Run 'aws configure' to set them up." >&2
      return 1
    fi
  else
    # Silent mode for normal operation
    if ! aws sts get-caller-identity --region "$region" >/dev/null 2>&1; then
      echo "Error: AWS credentials not found or invalid. Run 'aws configure' to set them up." >&2
      echo "Try running with --debug for more information." >&2
      return 1
    fi
  fi
  
  debug_log "AWS credentials verified successfully"
  return 0
}

# Function to check if a secret exists
check_secret() {
  local secret_name="$1"
  local region="$2"
  debug_log "Checking if secret '$secret_name' exists in region '$region'..."
  aws secretsmanager describe-secret --secret-id "$secret_name" --region "$region" >/dev/null 2>&1
  return $?
}

# Function to create a new secret
create_secret() {
  local secret_name="$1"
  local region="$2"
  
  echo "Creating new AWS Secret: $secret_name in region $region"
  debug_log "Running 'aws secretsmanager create-secret' command..."
  
  # Prepare debug flag for AWS CLI
  local aws_debug_flag=""
  if $DEBUG_MODE; then
    aws_debug_flag="--debug"
  fi
  
  # AWS CLI requires special handling for secret names with slashes
  if [[ "$secret_name" == */* ]]; then
    debug_log "Secret name contains slashes, using special handling for creation"
    
    if aws secretsmanager create-secret \
        --name "$secret_name" \
        --region "$region" \
        --secret-string '{}' \
        $aws_debug_flag >/dev/null 2>&1; then
      echo "Secret '$secret_name' created successfully."
      return 0
    else
      echo "Error: Failed to create secret '$secret_name'" >&2
      provide_iam_diagnostics "$secret_name" "$region" "create"
      return 1
    fi
  else
    # No slashes in name, use standard creation
    if aws secretsmanager create-secret \
        --name "$secret_name" \
        --region "$region" \
        --secret-string '{}' \
        $aws_debug_flag >/dev/null 2>&1; then
      echo "Secret '$secret_name' created successfully."
      return 0
    else
      echo "Error: Failed to create secret '$secret_name'" >&2
      provide_iam_diagnostics "$secret_name" "$region" "create"
      return 1
    fi
  fi
}

# Function to check IAM permissions
check_iam_permissions() {
  local secret_name="$1"
  local region="$2"
  
  echo "Checking IAM permissions for AWS Secrets Manager..."
  
  # Check read permissions
  debug_log "Testing read permissions..."
  if aws secretsmanager get-secret-value --secret-id "$secret_name" --region "$region" >/dev/null 2>&1; then
    echo "✓ You have read permissions for the secret."
  else
    echo "✗ You don't have read permissions for the secret."
  fi
  
  # Check write permissions (using list permissions as a proxy)
  debug_log "Testing list permissions..."
  if aws secretsmanager list-secrets --region "$region" >/dev/null 2>&1; then
    echo "✓ You have list permissions for secrets."
  else
    echo "✗ You don't have list permissions for secrets."
  fi
  
  # Check update permissions (only if the user has read permissions)
  if aws secretsmanager get-secret-value --secret-id "$secret_name" --region "$region" >/dev/null 2>&1; then
    debug_log "Testing update permissions..."
    if aws secretsmanager update-secret --secret-id "$secret_name" --region "$region" --description "Permissions Test" >/dev/null 2>&1; then
      echo "✓ You have update permissions for the secret."
      # Reset description to empty
      aws secretsmanager update-secret --secret-id "$secret_name" --region "$region" --description "" >/dev/null 2>&1
    else
      echo "✗ You don't have update permissions for the secret."
    fi
  fi
}

# Function to list keys inside the secret
list_keys() {
  local secret_name="$1"
  local region="$2"
  
  debug_log "Retrieving secret value from AWS Secrets Manager..."
  local secret_json
  if ! secret_json=$(aws secretsmanager get-secret-value --secret-id "$secret_name" --region "$region" --query 'SecretString' --output text 2>/dev/null); then
    echo "Error: Unable to retrieve secret '$secret_name'" >&2
    provide_iam_diagnostics "$secret_name" "$region" "access"
    return 1
  fi
  
  echo "Keys stored in '$secret_name':"
  echo "----------------------------"
  
  # Get all keys that don't end with .pub or .meta
  local keys
  keys=$(echo "$secret_json" | jq -r 'keys[] | select(endswith(".pub") | not) | select(endswith(".meta") | not)' 2>/dev/null | sort)
  
  if [ -z "$keys" ]; then
    echo "(No SSH keys found)"
    return 0
  fi
  
  # Print table header
  printf "%-30s %-12s %-12s %-20s %s\n" "Key Name" "Type" "Size" "Created" "Rotation Due"
  printf "%-30s %-12s %-12s %-20s %s\n" "--------" "----" "----" "-------" "------------"
  
  # Process each key
  echo "$keys" | while read -r key; do
    local meta_key="${key}.meta"
    local meta_data=""
    local key_type="unknown"
    local key_size="unknown"
    local created_date="unknown"
    local rotation_date="unknown"
    
    # Check if metadata exists for this key
    if echo "$secret_json" | jq -e --arg key "$meta_key" 'has($key)' >/dev/null; then
      # Get metadata string and parse it as JSON - this is the key change
      local meta_json=$(echo "$secret_json" | jq -r --arg key "$meta_key" '.[$key]')
      debug_log "Raw metadata: $meta_json"
      
      # Parse the JSON string to extract metadata
      key_type=$(echo "$meta_json" | jq -r '.key_type // "unknown"')
      key_size=$(echo "$meta_json" | jq -r '.key_size // "unknown"')
      created_date=$(echo "$meta_json" | jq -r '.created // "unknown"' | cut -d'T' -f1)
      rotation_date=$(echo "$meta_json" | jq -r '.rotation_recommended // "unknown"' | cut -d'T' -f1)
    fi
    
    printf "%-30s %-12s %-12s %-20s %s\n" "$key" "$key_type" "$key_size" "$created_date" "$rotation_date"
  done
}

# Function to show key details
show_key_details() {
  local secret_name="$1"
  local region="$2"
  local key_name="$3"
  
  debug_log "Retrieving secret value for key '$key_name'..."
  local secret_json
  if ! secret_json=$(aws secretsmanager get-secret-value --secret-id "$secret_name" --region "$region" --query 'SecretString' --output text 2>/dev/null); then
    echo "Error: Unable to retrieve secret '$secret_name'" >&2
    provide_iam_diagnostics "$secret_name" "$region" "access"
    return 1
  fi
  
  # Check if the key exists
  if ! echo "$secret_json" | jq -e --arg key "$key_name" 'has($key)' >/dev/null; then
    echo "Error: Key '$key_name' not found in secret '$secret_name'" >&2
    return 1
  fi
  
  echo "Details for key: $key_name"
  echo "------------------------"
  
  # Check for metadata
  local meta_key="${key_name}.meta"
  if echo "$secret_json" | jq -e --arg key "$meta_key" 'has($key)' >/dev/null; then
    # Get the JSON string metadata and parse it
    local meta_json=$(echo "$secret_json" | jq -r --arg key "$meta_key" '.[$key]')
    debug_log "Raw metadata JSON string: $meta_json"
    
    # Print basic info from parsed JSON
    echo "Key type:            $(echo "$meta_json" | jq -r '.key_type // "unknown"')"
    echo "Key size:            $(echo "$meta_json" | jq -r '.key_size // "unknown"')"
    echo "Comment:             $(echo "$meta_json" | jq -r '.comment // "none"')"
    echo "Fingerprint:         $(echo "$meta_json" | jq -r '.fingerprint // "unknown"')"
    echo "Created:             $(echo "$meta_json" | jq -r '.created // "unknown"')"
    echo "Last updated:        $(echo "$meta_json" | jq -r '.updated // "unknown"')"
    echo "Updated by:          $(echo "$meta_json" | jq -r '.updated_by // "unknown"')"
    echo "Current version:     $(echo "$meta_json" | jq -r '.version // "1"')"
    echo "Rotation due:        $(echo "$meta_json" | jq -r '.rotation_recommended // "unknown"')"
    
    # Check if public key exists
    local pub_key="${key_name}.pub"
    if echo "$secret_json" | jq -e --arg key "$pub_key" 'has($key)' >/dev/null; then
      echo "Public key:          Available"
      echo ""
      echo "Public key content:"
      echo "-------------------"
      echo "$secret_json" | jq -r --arg key "$pub_key" '.[$key]'
    else
      echo "Public key:          Not available"
    fi
    
    # Show rotation history if available
    if echo "$meta_json" | jq -e 'has("rotation_history")' >/dev/null; then
      echo ""
      echo "Rotation History:"
      echo "----------------"
      printf "%-25s %s\n" "Date" "Version"
      printf "%-25s %s\n" "----" "-------"
      
      echo "$meta_json" | jq -r '.rotation_history[] | "\(.timestamp) \(.version)"' | while read -r date version; do
        printf "%-25s %s\n" "$date" "$version"
      done
    fi
  else
    echo "No metadata available for this key."
    
    # Check if public key exists
    local pub_key="${key_name}.pub"
    if echo "$secret_json" | jq -e --arg key "$pub_key" 'has($key)' >/dev/null; then
      echo "Public key:          Available"
      echo ""
      echo "Public key content:"
      echo "-------------------"
      echo "$secret_json" | jq -r --arg key "$pub_key" '.[$key]'
    else
      echo "Public key:          Not available"
    fi
  fi
}

# Main function to handle the flow of the script
main() {
  # Parse command line arguments
  REGION="$DEFAULT_REGION"
  SECRET_NAME="$DEFAULT_SECRET_NAME"
  DO_LIST=false
  DETAIL_KEY=""
  CREATE_SECRET=false
  ENV_ONLY=false
  
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)
        usage
        ;;
      -r|--region)
        REGION="$2"
        shift 2
        ;;
      -s|--secret)
        SECRET_NAME="$2"
        shift 2
        ;;
      -l|--list)
        DO_LIST=true
        shift
        ;;
      -d|--detail)
        DETAIL_KEY="$2"
        shift 2
        ;;
      -c|--create)
        CREATE_SECRET=true
        shift
        ;;
      -e|--env)
        ENV_ONLY=true
        shift
        ;;
      --debug)
        DEBUG_MODE=true
        shift
        ;;
      *)
        echo "Unknown option: $1" >&2
        usage
        ;;
    esac
  done
  
  # Check dependencies
  check_dependencies
  
  # Check if environment is properly configured
  local missing_env_vars=$(check_environment_configuration)
  if [ $missing_env_vars -gt 0 ]; then
    echo "Environment not fully configured. Starting environment setup..."
    manage_environment
    
    # Re-check environment after setup
    missing_env_vars=$(check_environment_configuration)
    if [ $missing_env_vars -gt 0 ] && [ "$ENV_ONLY" = false ]; then
      echo "Warning: Environment still not fully configured. Proceeding with available settings."
    fi
  fi
  
  # If environment-only mode, exit here
  if [ "$ENV_ONLY" = true ]; then
    echo "Environment configuration completed. Exiting as requested (--env mode)."
    exit 0
  fi
  
  # Export updated values for secret and region
  export SHH_SECRETS="${SHH_SECRETS:-$DEFAULT_SECRET_NAME}"
  export SHH_REGION="${SHH_REGION:-$DEFAULT_REGION}"
  export AWS_DEFAULT_REGION="${SHH_REGION:-$DEFAULT_REGION}"
  SECRET_NAME="${SHH_SECRETS}"
  REGION="${SHH_REGION}"
  
  echo "Using AWS Secret: $SECRET_NAME in region: $REGION"
  
  # Check AWS credentials
  if ! check_aws_credentials "$REGION"; then
    exit 1
  fi
  
  # Check if secret exists, create if needed
  if check_secret "$SECRET_NAME" "$REGION"; then
  echo "Secret '$SECRET_NAME' exists."
    
    # Check IAM permissions
    check_iam_permissions "$SECRET_NAME" "$REGION"
  else
    if [ "$CREATE_SECRET" = true ]; then
      # Non-interactive creation requested
      if create_secret "$SECRET_NAME" "$REGION"; then
        check_iam_permissions "$SECRET_NAME" "$REGION"
      else
        exit 1
      fi
else
      # Interactive mode
  echo -n "Secret '$SECRET_NAME' does not exist. Create it? (y/n): "
      read -r CONFIRM
  if [[ "$CONFIRM" =~ ^[Yy]$ ]]; then
        if create_secret "$SECRET_NAME" "$REGION"; then
          check_iam_permissions "$SECRET_NAME" "$REGION"
        else
          exit 1
        fi
  else
    echo "Secret creation canceled."
        exit 1
      fi
  fi
fi

  # Show key details if requested
  if [[ -n "$DETAIL_KEY" ]]; then
    show_key_details "$SECRET_NAME" "$REGION" "$DETAIL_KEY"
    exit 0
  fi
  
  # List keys if requested or ask if in interactive mode
  if $DO_LIST; then
    list_keys "$SECRET_NAME" "$REGION"
  else
echo -n "Would you like to list stored keys in '$SECRET_NAME'? (y/n): "
    read -r LIST_KEYS
if [[ "$LIST_KEYS" =~ ^[Yy]$ ]]; then
      list_keys "$SECRET_NAME" "$REGION"
    fi
fi
}

# Run the main function
main "$@"

exit 0
