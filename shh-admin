#!/bin/bash

# Function to check if a secret exists
check_secret() {
  aws secretsmanager describe-secret --secret-id "$1" >/dev/null 2>&1
}

# Function to create a new secret
create_secret() {
  local SECRET_NAME="$1"
  echo "Creating new AWS Secret: $SECRET_NAME"
  aws secretsmanager create-secret --name "$SECRET_NAME" --secret-string '{}' >/dev/null 2>&1
  echo "Secret '$SECRET_NAME' created successfully."
}

# Function to list keys inside the secret
list_keys() {
  local SECRET_JSON
  SECRET_JSON=$(aws secretsmanager get-secret-value --secret-id "$1" --query 'SecretString' --output text || echo '{}')
  echo "Keys stored in '$1':"
  echo "$SECRET_JSON" | jq 'keys' || echo "(No keys found)"
}

# Prompt for the secret name
echo -n "Enter AWS Secret Manager Secret Name (default: $SHH_SECRETS): "
read SECRET_NAME
SECRET_NAME=${SECRET_NAME:-$SHH_SECRETS}

# Export the secret name for subsequent use
export SHH_SECRETS="$SECRET_NAME"
echo "Using AWS Secret: $SHH_SECRETS"

if check_secret "$SECRET_NAME"; then
  echo "Secret '$SECRET_NAME' exists."
else
  echo -n "Secret '$SECRET_NAME' does not exist. Create it? (y/n): "
  read CONFIRM
  if [[ "$CONFIRM" =~ ^[Yy]$ ]]; then
    create_secret "$SECRET_NAME"
  else
    echo "Secret creation canceled."
    return 1
  fi
fi

# Ask if user wants to list existing keys
echo -n "Would you like to list stored keys in '$SECRET_NAME'? (y/n): "
read LIST_KEYS
if [[ "$LIST_KEYS" =~ ^[Yy]$ ]]; then
  list_keys "$SECRET_NAME"
fi
