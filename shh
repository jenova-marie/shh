#!/bin/bash

# Exit on errors
set -e

# ANSI color codes for pretty output
PINK="\033[38;5;206m"     # Hot pink for primary headings
GREEN="\033[38;5;46m"     # Bright green for success messages
YELLOW="\033[38;5;220m"   # Yellow for warnings and important info
BLUE="\033[38;5;39m"      # Blue for option categories
CYAN="\033[38;5;87m"      # Cyan for options
WHITE="\033[97m"          # White for normal text
HOTPINK="\033[38;5;198m"  # Hot pink for parameter names (brighter than PINK)
ORANGE="\033[38;5;208m"   # Orange (deprecated, use HOTPINK instead)
GRAY="\033[38;5;246m"     # Gray for descriptions
RED="\033[38;5;196m"      # Bright red for errors
BOLD="\033[1m"            # Bold text
UNDERLINE="\033[4m"       # Underlined text
RESET="\033[0m"           # Reset all formatting

# Get the directory of the current script
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

# Function to display usage
usage() {
  echo -e "${PINK}${BOLD}╔════════════════════════════════════════════════╗${RESET}"
  echo -e "${PINK}${BOLD}║           Shh - Secure SSH Client              ║${RESET}"
  echo -e "${PINK}${BOLD}╚════════════════════════════════════════════════╝${RESET}"
  echo ""
  echo -e "${UNDERLINE}${BOLD}USAGE:${RESET}"
  echo -e "  ${WHITE}$(basename "$0") ${HOTPINK}[options] ${HOTPINK}<user@host> ${HOTPINK}[region]${RESET}"
  echo ""
  echo -e "${UNDERLINE}${BOLD}ARGUMENTS:${RESET}"
  echo -e "  ${HOTPINK}user@host${RESET}      ${WHITE}Remote SSH destination${RESET}"
  echo -e "  ${HOTPINK}region${RESET}         ${WHITE}AWS region (uses ${CYAN}SHH_REGION${WHITE} or ${CYAN}AWS_REGION${WHITE} if not specified)${RESET}"
  echo ""
  echo -e "${BLUE}${BOLD}SHH OPTIONS:${RESET}"
  echo -e "  ${CYAN}-i <key-name>${RESET}  ${WHITE}Specify the SSH key name stored in AWS Secrets Manager${RESET}"
  echo -e "                 ${GRAY}(default: tries 'user_host_ed25519' then 'username_ed25519')${RESET}"
  echo -e "  ${CYAN}--debug${RESET}        ${WHITE}Enable verbose debugging output${RESET}"
  echo -e "  ${CYAN}--env${RESET}          ${WHITE}Manage environment variables with shh-env${RESET}"
  echo -e "  ${CYAN}--help${RESET}|${CYAN}-h${RESET}      ${WHITE}Display this help message${RESET}"
  echo ""
  echo -e "${YELLOW}${BOLD}IMPORTANT:${RESET} ${WHITE}Shh supports all standard SSH options and flags.${RESET}"
  echo -e "${WHITE}These are passed directly to the underlying SSH command:${RESET}"
  echo -e "  ${GRAY}# Standard SSH options are fully supported${RESET}"
  echo -e "  ${WHITE}$(basename "$0") -p 2222 -X -o ConnectTimeout=10 user@hostname${RESET}"
  echo -e ""
  echo -e "${WHITE}Use with other tools that expect SSH:${RESET}"
  echo -e "  ${GRAY}# For SCP:${RESET}"
  echo -e "  ${WHITE}scp -S shh localfile user@host:remotepath${RESET}"
  echo -e ""
  echo -e "  ${GRAY}# For RSYNC:${RESET}"
  echo -e "  ${WHITE}rsync -e \"shh\" localfile user@host:remotepath${RESET}"
  echo ""
  echo -e "${UNDERLINE}${BOLD}ENVIRONMENT SETUP:${RESET}"
  echo -e "  ${WHITE}Run '${CYAN}shh-env${WHITE}' to configure your environment variables${RESET}"
  echo -e "  ${WHITE}Run '${CYAN}shh-admin${WHITE}' to manage your AWS Secrets Manager secrets${RESET}"
  exit 1
}

# Function for debug logging
debug_log() {
  if [ "$DEBUG_MODE" = true ]; then
    echo -e "${GRAY}[DEBUG] $1${RESET}"
  fi
}

# Check dependencies
check_dependencies() {
  for cmd in aws jq base64 ssh-add ssh-agent grep; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
      echo -e "${RED}${BOLD}Error:${RESET} Required command '${CYAN}$cmd${RESET}' not found. Please install it." >&2
      exit 1
    fi
  done
}

# Function to manage environment
manage_environment() {
  echo -e "${BLUE}${BOLD}Managing SHH environment variables...${RESET}"
  
  # Check if shh-env exists and is executable
  if [ ! -x "$SCRIPT_DIR/shh-env" ]; then
    echo -e "${RED}${BOLD}Error:${RESET} shh-env script not found or not executable."
    return 1
  fi
  
  # Run shh-env with interactive menu
  "$SCRIPT_DIR/shh-env" --menu "$@"
  
  # Environment variables should now be set by shh-env, export them to current session
  if [ -n "${SHH_REGION:-}" ]; then
    export SHH_REGION
    export AWS_DEFAULT_REGION="$SHH_REGION"
  fi
  
  if [ -n "${SHH_SECRETS:-}" ]; then
    export SHH_SECRETS
  fi
  
  if [ -n "${SHH_DEBUG:-}" ]; then
    export SHH_DEBUG
  fi
  
  # If this was called with --env from command line, exit after environment configuration
  if [[ "$1" == "--env" ]]; then
    exit 0
  fi
  
  return 0
}

# Function to check required SHH environment variables
check_shh_environment() {
  local missing_vars=()
  
  # Check for SHH_SECRETS
  if [ -z "${SHH_SECRETS}" ]; then
    missing_vars+=("SHH_SECRETS")
  fi
  
  # Check for region from any of the possible sources
  if [ -z "${SHH_REGION}" ] && [ -z "${AWS_REGION}" ] && [ -z "${AWS_DEFAULT_REGION}" ]; then
    missing_vars+=("SHH_REGION")
  fi
  
  # If any required variables are missing
  if [ ${#missing_vars[@]} -gt 0 ]; then
    echo -e "${YELLOW}${BOLD}Error:${RESET} Required environment variable(s) not set: ${HOTPINK}${missing_vars[*]}${RESET}" >&2
    echo -e "Would you like to configure these variables now using shh-admin? (y/n): " >&2
    read -r CONFIGURE
    
    if [[ "$CONFIGURE" =~ ^[Yy]$ ]]; then
      echo -e "${BLUE}Launching shh-admin environment configuration...${RESET}" >&2
      "$SCRIPT_DIR/shh-admin" --env
      exit 0
    else
      echo -e "Please run '${CYAN}shh-env${RESET}' or '${CYAN}shh-admin --env${RESET}' to configure your environment." >&2
      exit 1
    fi
  fi
}

# Parse arguments
DEBUG_MODE=false
KEY_NAME=""
USER_HOST=""
REGION=""
SSH_OPTS=()

# Add default SSH options
SSH_OPTS+=("-o" "StrictHostKeyChecking=accept-new")

# Complete list of SSH options that take an argument
SSH_OPTS_WITH_ARG=(
  "-b" "-c" "-D" "-E" "-e" "-F" "-I" "-i" "-J" "-L" "-l" "-m" "-O" "-o" "-p" "-Q" 
  "-R" "-S" "-W" "-w"
)

# List of single-letter SSH flags that don't take arguments
SSH_FLAGS_NO_ARG=(
  "-4" "-6" "-A" "-a" "-C" "-f" "-G" "-g" "-K" "-k" "-M" "-N" "-n" "-q" "-s" "-T" 
  "-t" "-V" "-v" "-X" "-x" "-Y" "-y"
)

# Function to check if an option requires an argument
requires_argument() {
  local option="$1"
  local first_char="${option:0:2}"
  
  # Check for extended options like -oSomething
  if [ ${#option} -gt 2 ] && [[ " ${SSH_OPTS_WITH_ARG[*]} " == *" ${first_char} "* ]]; then
    return 1  # Option is combined with its argument
  fi
  
  # Check for regular options that need arguments
  for opt in "${SSH_OPTS_WITH_ARG[@]}"; do
    if [[ "$option" == "$opt" ]]; then
      return 0  # Requires separate argument
    fi
  done
  
  return 1  # Does not require argument
}

# Function to check if option is a single flag
is_single_flag() {
  local option="$1"
  for flag in "${SSH_FLAGS_NO_ARG[@]}"; do
    if [[ "$option" == "$flag" ]]; then
      return 0
    fi
  done
  return 1
}

# Parse command line options first (following ssh style)
while [[ $# -gt 0 ]]; do
  case "$1" in
    --debug)
      DEBUG_MODE=true
      SSH_OPTS+=("-v")
      shift
      ;;
    --env)
      # Pass remaining arguments to environment manager
      shift
      manage_environment "--env" "$@"
      ;;
    --help|-h)
      usage
      ;;
    -i)
      if [[ $# -lt 2 ]]; then
        echo -e "${RED}${BOLD}Error:${RESET} -i option requires an argument" >&2
        usage
      fi
      KEY_NAME="$2"
      shift 2
      ;;
    -o*)
      # Special handling for SSH options with equals sign
      if [[ "$1" == -o*=* ]]; then
        # -oKey=Value format
        SSH_OPTS+=("$1")
        shift
      elif [[ "$1" == "-o" ]] && [[ $# -gt 1 ]]; then
        # -o Key=Value format
        SSH_OPTS+=("$1" "$2")
        shift 2
      else
        # Invalid -o usage
        echo -e "${RED}${BOLD}Error:${RESET} -o option requires an argument" >&2
        usage
      fi
      ;;
    -*)
      # Check if this is a combined option (e.g., -4Cn)
      if [[ ${#1} -gt 2 ]] && [[ "${1:0:1}" == "-" ]] && [[ "${1:1:1}" != "-" ]]; then
        # It's a combined option, split into individual flags
        debug_log "Splitting combined option: $1"
        options_string="${1:1}"  # Remove leading dash
        for (( i=0; i<${#options_string}; i++ )); do
          flag="-${options_string:$i:1}"
          if is_single_flag "$flag"; then
            SSH_OPTS+=("$flag")
          else
            # Unknown flag or one that requires an argument
            echo -e "${YELLOW}${BOLD}Warning:${RESET} Passing combined option '$1' as is" >&2
            SSH_OPTS+=("$1")
            break
          fi
        done
        shift
      elif requires_argument "$1" && [[ $# -gt 1 ]]; then
        # Handle SSH options that take arguments
        SSH_OPTS+=("$1" "$2")
        shift 2
      else
        # Single options without arguments
        SSH_OPTS+=("$1")
        shift
      fi
      ;;
    *)
      # Non-option arguments
      if [ -z "$USER_HOST" ]; then
        USER_HOST="$1"
      elif [ -z "$REGION" ]; then
        REGION="$1"
      else
        # If we have extra arguments, assume they're for ssh
        SSH_OPTS+=("$1")
      fi
      shift
      ;;
  esac
done

# Validate required arguments
if [ -z "$USER_HOST" ]; then
  echo -e "${RED}${BOLD}Error:${RESET} Missing user@host argument." >&2
  usage
fi

# Check for required environment variables
check_shh_environment

# Set region from environment or command line
if [ -z "$REGION" ]; then
  if [ -n "${SHH_REGION}" ]; then
    REGION="${SHH_REGION}"
  elif [ -n "${AWS_REGION}" ]; then
    REGION="${AWS_REGION}"
  elif [ -n "${AWS_DEFAULT_REGION}" ]; then
    REGION="${AWS_DEFAULT_REGION}"
  else
    echo -e "${RED}${BOLD}Error:${RESET} AWS region not specified and no region environment variable set." >&2
    echo -e "Please specify a region or run '${CYAN}shh-env${RESET}' to configure your environment." >&2
    exit 1
  fi
fi

# If KEY_NAME is not specified, derive it from username
if [ -z "$KEY_NAME" ]; then
  # First try: Use the full user@host pattern (replacing @ with _)
  FULL_HOST_KEY=$(echo "$USER_HOST" | tr '@' '_')"_ed25519"
  debug_log "No key specified, trying full host key pattern '$FULL_HOST_KEY'"
  
  # Retrieve the SSH key from AWS Secrets Manager (moved this code up from below)
  debug_log "Retrieving keys from secret '${SHH_SECRETS}' in region '$REGION'..."
  SECRET_JSON=$(aws secretsmanager get-secret-value --secret-id "${SHH_SECRETS}" --region "$REGION" --query SecretString --output text 2>/dev/null) || {
    echo -e "${RED}${BOLD}Error:${RESET} Failed to retrieve secret '${CYAN}${SHH_SECRETS}${RESET}' from AWS Secrets Manager in region '${CYAN}$REGION${RESET}'!" >&2
    echo -e "Please check your AWS credentials and secret configuration." >&2
    echo -e "Run '${CYAN}shh-admin${RESET}' to manage your AWS secrets." >&2
    exit 1
  }
  
  # Check if the full host key exists in the secret
  if echo "$SECRET_JSON" | jq -e --arg key "$FULL_HOST_KEY" 'has($key)' >/dev/null; then
    KEY_NAME="$FULL_HOST_KEY"
    debug_log "Found key using full host pattern: '$KEY_NAME'"
  else
    # Fallback: Extract username from user@host (original behavior)
    USERNAME=$(echo "$USER_HOST" | cut -d '@' -f 1)
    KEY_NAME="${USERNAME}_ed25519"
    debug_log "Full host key not found, defaulting to username-based key '$KEY_NAME'"
  fi
fi

# Export region for AWS CLI
export AWS_DEFAULT_REGION="$REGION"

# Check dependencies
check_dependencies

# Start ssh-agent if not running
if ! pgrep -x "ssh-agent" >/dev/null 2>&1; then
  debug_log "Starting ssh-agent..."
  if [ "$DEBUG_MODE" = true ]; then
  eval "$(ssh-agent -s)"
  else
    eval "$(ssh-agent -s)" >/dev/null
  fi
fi

# If we already retrieved the secrets above, skip the retrieval
if [ -z "${SECRET_JSON:-}" ]; then
  debug_log "Retrieving key '$KEY_NAME' from secret '${SHH_SECRETS}' in region '$REGION'..."
  
  # Retrieve the SSH key from AWS Secrets Manager
  SECRET_JSON=$(aws secretsmanager get-secret-value --secret-id "${SHH_SECRETS}" --region "$REGION" --query SecretString --output text 2>/dev/null) || {
    echo -e "${RED}${BOLD}Error:${RESET} Failed to retrieve secret '${CYAN}${SHH_SECRETS}${RESET}' from AWS Secrets Manager in region '${CYAN}$REGION${RESET}'!" >&2
    echo -e "Please check your AWS credentials and secret configuration." >&2
    echo -e "Run '${CYAN}shh-admin${RESET}' to manage your AWS secrets." >&2
    exit 1
  }
else
  debug_log "Using previously retrieved secret data for key '$KEY_NAME'"
fi

# Extract private key using jq (base64 encoded)
SSH_PRIVATE_KEY_B64=$(echo "$SECRET_JSON" | jq -r --arg key "$KEY_NAME" '.[$key] // empty')
if [ -z "$SSH_PRIVATE_KEY_B64" ]; then
  echo -e "${RED}${BOLD}Error:${RESET} Key '${CYAN}$KEY_NAME${RESET}' not found in secret '${CYAN}${SHH_SECRETS}${RESET}'!" >&2
  
  # If we tried the full host pattern key and it failed, suggest it might not exist yet
  if [[ "$KEY_NAME" == $(echo "$USER_HOST" | tr '@' '_')"_ed25519" ]]; then
    echo -e "${YELLOW}${BOLD}Note:${RESET} No key found for the full host pattern. You may need to create it." >&2
    echo -e "Run '${CYAN}shh-admin --gen${RESET}' to generate a new key for this host." >&2
  fi
  
  if [ "$DEBUG_MODE" = true ]; then
    echo -e "${BLUE}${BOLD}Available keys:${RESET}" >&2
    echo "$SECRET_JSON" | jq -r 'keys[]' | grep -v "\.pub$" | grep -v "\.meta$" | grep -v "\.fp$" | sort >&2
  fi
  echo -e "Use '${CYAN}shh-admin --list${RESET}' to see available keys." >&2
  exit 1
fi

# Decode the base64-encoded private key
SSH_PRIVATE_KEY=$(echo "$SSH_PRIVATE_KEY_B64" | base64 --decode)

# Try to get metadata and public key if they exist
SSH_PUBLIC_KEY=$(echo "$SECRET_JSON" | jq -r --arg key "$KEY_NAME.pub" '.[$key] // empty')
META_KEY="${KEY_NAME}.meta"

# Get fingerprint from metadata if it exists
SSH_PUBLIC_KEY_FP=""
if echo "$SECRET_JSON" | jq -e --arg key "$META_KEY" 'has($key)' >/dev/null; then
  # Get the metadata JSON string
  META_JSON=$(echo "$SECRET_JSON" | jq -r --arg key "$META_KEY" '.[$key]')
  debug_log "Raw metadata JSON string: $META_JSON"
  
  # Extract fingerprint from metadata
  if echo "$META_JSON" | jq -e 'has("fingerprint")' >/dev/null; then
    SSH_PUBLIC_KEY_FP=$(echo "$META_JSON" | jq -r '.fingerprint // ""')
    debug_log "Extracted fingerprint from metadata: $SSH_PUBLIC_KEY_FP"
  fi
  
  # Display key information if in debug mode
  if [ "$DEBUG_MODE" = true ]; then
    KEY_TYPE=$(echo "$META_JSON" | jq -r '.key_type // "unknown"')
    KEY_SIZE=$(echo "$META_JSON" | jq -r '.key_size // "unknown"')
    CREATED=$(echo "$META_JSON" | jq -r '.created // "unknown"')
    VERSION=$(echo "$META_JSON" | jq -r '.version // "1"')
    ROTATION=$(echo "$META_JSON" | jq -r '.rotation_recommended // "unknown"')
    
    echo -e "${BLUE}${BOLD}Key information:${RESET}"
    echo -e "- Type: ${CYAN}$KEY_TYPE${RESET}"
    echo -e "- Size: ${CYAN}$KEY_SIZE${RESET}"
    echo -e "- Created: ${CYAN}$CREATED${RESET}"
    echo -e "- Version: ${CYAN}$VERSION${RESET}"
    echo -e "- Rotation due: ${CYAN}$ROTATION${RESET}"
  fi
else
  debug_log "No metadata found for key '$KEY_NAME'"
  
  # Backward compatibility: Check for old-style fingerprint
  OLD_FP_KEY="${KEY_NAME}.fp"
  if echo "$SECRET_JSON" | jq -e --arg key "$OLD_FP_KEY" 'has($key)' >/dev/null; then
    SSH_PUBLIC_KEY_FP=$(echo "$SECRET_JSON" | jq -r --arg key "$OLD_FP_KEY" '.[$key] // empty')
    debug_log "Found legacy fingerprint: $SSH_PUBLIC_KEY_FP"
  fi
fi

# Check if the key is already in ssh-agent using fingerprint
IS_KEY_LOADED=false
if [ -n "$SSH_PUBLIC_KEY_FP" ]; then
  if ssh-add -l 2>/dev/null | grep -q "$SSH_PUBLIC_KEY_FP"; then
    debug_log "Key '$KEY_NAME' is already loaded in ssh-agent, skipping ssh-add."
    IS_KEY_LOADED=true
  else
    debug_log "Key '$KEY_NAME' not loaded in ssh-agent, adding it now..."
    IS_KEY_LOADED=false
  fi
else
  debug_log "Key fingerprint not found in metadata or legacy fields, can't check if key is loaded in ssh-agent."
  debug_log "Will attempt to load the key."
  IS_KEY_LOADED=false
fi

# Add key to ssh-agent if not already loaded
if [ "$IS_KEY_LOADED" = false ]; then
  # Add the key to ssh-agent directly from stdin without writing to a file
  if [ "$DEBUG_MODE" = true ]; then
    echo -e "${BLUE}${BOLD}Adding key to SSH agent...${RESET}"
    echo "$SSH_PRIVATE_KEY" | ssh-add -
  else
    echo "$SSH_PRIVATE_KEY" | ssh-add - 2>/dev/null
  fi
fi

# SSH into the host using the loaded key
debug_log "Connecting to $USER_HOST using key '$KEY_NAME'..."
debug_log "SSH options: ${SSH_OPTS[*]}"

if [ "$DEBUG_MODE" = true ]; then
  echo -e "${GREEN}${BOLD}Connecting to${RESET} ${CYAN}$USER_HOST${RESET} ${GREEN}using key${RESET} ${CYAN}$KEY_NAME${RESET}"
fi

# Execute the SSH command with all options
ssh "${SSH_OPTS[@]}" "$USER_HOST"

exit 0
