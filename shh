#!/bin/bash

# Exit on errors
set -e

# Get the directory of the current script
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

# Function to display usage
usage() {
  echo "Usage: $(basename "$0") [options] <user@host> [region]"
  echo ""
  echo "Arguments:"
  echo "  user@host      Remote SSH destination"
  echo "  region         AWS region (uses SHH_REGION or AWS_REGION environment variable if not specified)"
  echo ""
  echo "Options:"
  echo "  -i <key-name>  Specify the SSH key name stored in AWS Secrets Manager"
  echo "                 (default: uses '<username>_ed25519' from user@host)"
  echo "  --debug        Enable verbose debugging output"
  echo "  --env          Manage environment variables with shh-env"
  echo "  --help         Display this help message"
  echo ""
  echo "Environment Setup:"
  echo "  Run 'shh-env' to configure your environment variables"
  echo "  Run 'shh-admin' to manage your AWS Secrets Manager secrets"
  exit 1
}

# Function for debug logging
debug_log() {
  if [ "$DEBUG_MODE" = true ]; then
    echo "[DEBUG] $1"
  fi
}

# Check dependencies
check_dependencies() {
  for cmd in aws jq base64 ssh-add ssh-agent grep; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
      echo "Error: Required command '$cmd' not found. Please install it." >&2
      exit 1
    fi
  done
}

# Function to manage environment
manage_environment() {
  echo "Managing SHH environment variables..."
  
  # Check if shh-env exists and is executable
  if [ ! -x "$SCRIPT_DIR/shh-env" ]; then
    echo "Error: shh-env script not found or not executable."
    return 1
  fi
  
  # Run shh-env with interactive menu
  "$SCRIPT_DIR/shh-env" --menu "$@"
  exit 0
}

# Function to check required SHH environment variables
check_shh_environment() {
  local missing_vars=()
  
  # Check for SHH_SECRETS
  if [ -z "${SHH_SECRETS}" ]; then
    missing_vars+=("SHH_SECRETS")
  fi
  
  # Check for region from any of the possible sources
  if [ -z "${SHH_REGION}" ] && [ -z "${AWS_REGION}" ] && [ -z "${AWS_DEFAULT_REGION}" ]; then
    missing_vars+=("SHH_REGION")
  fi
  
  # If any required variables are missing
  if [ ${#missing_vars[@]} -gt 0 ]; then
    echo "Error: Required environment variable(s) not set: ${missing_vars[*]}" >&2
    echo "Would you like to configure these variables now using shh-admin? (y/n): " >&2
    read -r CONFIGURE
    
    if [[ "$CONFIGURE" =~ ^[Yy]$ ]]; then
      echo "Launching shh-admin environment configuration..." >&2
      "$SCRIPT_DIR/shh-admin" --env
      exit 0
    else
      echo "Please run 'shh-env' or 'shh-admin --env' to configure your environment." >&2
      exit 1
    fi
  fi
}

# Parse arguments
DEBUG_MODE=false
KEY_NAME=""
USER_HOST=""
REGION=""
SSH_OPTS=()

# Add default SSH options
SSH_OPTS+=("-o" "StrictHostKeyChecking=accept-new")

# Parse command line options first (following ssh style)
while [[ $# -gt 0 ]]; do
  case "$1" in
    -i)
      if [[ $# -lt 2 ]]; then
        echo "Error: -i option requires an argument" >&2
        usage
      fi
      KEY_NAME="$2"
      shift 2
      ;;
    --debug)
      DEBUG_MODE=true
      SSH_OPTS+=("-v")
      shift
      ;;
    --env)
      # Pass remaining arguments to environment manager
      shift
      manage_environment "$@"
      ;;
    --help|-h)
      usage
      ;;
    -*)
      # Pass through any other SSH options
      SSH_OPTS+=("$1")
      shift
      ;;
    *)
      # Non-option arguments
      if [ -z "$USER_HOST" ]; then
        USER_HOST="$1"
      elif [ -z "$REGION" ]; then
        REGION="$1"
      else
        echo "Error: Unexpected argument '$1'"
        usage
      fi
      shift
      ;;
  esac
done

# Validate required arguments
if [ -z "$USER_HOST" ]; then
  echo "Error: Missing user@host argument." >&2
  usage
fi

# Check for required environment variables
check_shh_environment

# Set region from environment or command line
if [ -z "$REGION" ]; then
  if [ -n "${SHH_REGION}" ]; then
    REGION="${SHH_REGION}"
  elif [ -n "${AWS_REGION}" ]; then
    REGION="${AWS_REGION}"
  elif [ -n "${AWS_DEFAULT_REGION}" ]; then
    REGION="${AWS_DEFAULT_REGION}"
  else
    echo "Error: AWS region not specified and no region environment variable set." >&2
    echo "Please specify a region or run 'shh-env' to configure your environment." >&2
    exit 1
  fi
fi

# If KEY_NAME is not specified, derive it from username
if [ -z "$KEY_NAME" ]; then
  # Extract username from user@host
  USERNAME=$(echo "$USER_HOST" | cut -d '@' -f 1)
  KEY_NAME="${USERNAME}_ed25519"
  debug_log "No key specified, defaulting to '$KEY_NAME'"
fi

# Export region for AWS CLI
export AWS_DEFAULT_REGION="$REGION"

# Check dependencies
check_dependencies

# Start ssh-agent if not running
if ! pgrep -x "ssh-agent" >/dev/null 2>&1; then
  debug_log "Starting ssh-agent..."
  if [ "$DEBUG_MODE" = true ]; then
    eval "$(ssh-agent -s)"
  else
    eval "$(ssh-agent -s)" >/dev/null
  fi
fi

debug_log "Retrieving key '$KEY_NAME' from secret '${SHH_SECRETS}' in region '$REGION'..."

# Retrieve the SSH key from AWS Secrets Manager
SECRET_JSON=$(aws secretsmanager get-secret-value --secret-id "${SHH_SECRETS}" --region "$REGION" --query SecretString --output text 2>/dev/null) || {
  echo "Error: Failed to retrieve secret '${SHH_SECRETS}' from AWS Secrets Manager in region '$REGION'!" >&2
  echo "Please check your AWS credentials and secret configuration." >&2
  echo "Run 'shh-admin' to manage your AWS secrets." >&2
  exit 1
}

# Extract private key using jq (base64 encoded)
SSH_PRIVATE_KEY_B64=$(echo "$SECRET_JSON" | jq -r --arg key "$KEY_NAME" '.[$key] // empty')
if [ -z "$SSH_PRIVATE_KEY_B64" ]; then
  echo "Error: Key '$KEY_NAME' not found in secret '${SHH_SECRETS}'!" >&2
  if [ "$DEBUG_MODE" = true ]; then
    echo "Available keys:" >&2
    echo "$SECRET_JSON" | jq -r 'keys[]' | grep -v "\.pub$" | grep -v "\.meta$" | grep -v "\.fp$" | sort >&2
  fi
  echo "Use 'shh-admin --list' to see available keys." >&2
  exit 1
fi

# Decode the base64-encoded private key
SSH_PRIVATE_KEY=$(echo "$SSH_PRIVATE_KEY_B64" | base64 --decode)

# Try to get metadata and public key if they exist
SSH_PUBLIC_KEY=$(echo "$SECRET_JSON" | jq -r --arg key "$KEY_NAME.pub" '.[$key] // empty')
META_KEY="${KEY_NAME}.meta"

# Get fingerprint from metadata if it exists
SSH_PUBLIC_KEY_FP=""
if echo "$SECRET_JSON" | jq -e --arg key "$META_KEY" 'has($key)' >/dev/null; then
  # Get the metadata JSON string
  META_JSON=$(echo "$SECRET_JSON" | jq -r --arg key "$META_KEY" '.[$key]')
  debug_log "Raw metadata JSON string: $META_JSON"
  
  # Extract fingerprint from metadata
  if echo "$META_JSON" | jq -e 'has("fingerprint")' >/dev/null; then
    SSH_PUBLIC_KEY_FP=$(echo "$META_JSON" | jq -r '.fingerprint // ""')
    debug_log "Extracted fingerprint from metadata: $SSH_PUBLIC_KEY_FP"
  fi
  
  # Display key information if in debug mode
  if [ "$DEBUG_MODE" = true ]; then
    KEY_TYPE=$(echo "$META_JSON" | jq -r '.key_type // "unknown"')
    KEY_SIZE=$(echo "$META_JSON" | jq -r '.key_size // "unknown"')
    CREATED=$(echo "$META_JSON" | jq -r '.created // "unknown"')
    VERSION=$(echo "$META_JSON" | jq -r '.version // "1"')
    ROTATION=$(echo "$META_JSON" | jq -r '.rotation_recommended // "unknown"')
    
    echo "Key information:"
    echo "- Type: $KEY_TYPE"
    echo "- Size: $KEY_SIZE"
    echo "- Created: $CREATED"
    echo "- Version: $VERSION"
    echo "- Rotation due: $ROTATION"
  fi
else
  debug_log "No metadata found for key '$KEY_NAME'"
  
  # Backward compatibility: Check for old-style fingerprint
  OLD_FP_KEY="${KEY_NAME}.fp"
  if echo "$SECRET_JSON" | jq -e --arg key "$OLD_FP_KEY" 'has($key)' >/dev/null; then
    SSH_PUBLIC_KEY_FP=$(echo "$SECRET_JSON" | jq -r --arg key "$OLD_FP_KEY" '.[$key] // empty')
    debug_log "Found legacy fingerprint: $SSH_PUBLIC_KEY_FP"
  fi
fi

# Check if the key is already in ssh-agent using fingerprint
IS_KEY_LOADED=false
if [ -n "$SSH_PUBLIC_KEY_FP" ]; then
  if ssh-add -l 2>/dev/null | grep -q "$SSH_PUBLIC_KEY_FP"; then
    debug_log "Key '$KEY_NAME' is already loaded in ssh-agent, skipping ssh-add."
    IS_KEY_LOADED=true
  else
    debug_log "Key '$KEY_NAME' not loaded in ssh-agent, adding it now..."
    IS_KEY_LOADED=false
  fi
else
  debug_log "Key fingerprint not found in metadata or legacy fields, can't check if key is loaded in ssh-agent."
  debug_log "Will attempt to load the key."
  IS_KEY_LOADED=false
fi

# Add key to ssh-agent if not already loaded
if [ "$IS_KEY_LOADED" = false ]; then
  # Add the key to ssh-agent directly from stdin without writing to a file
  if [ "$DEBUG_MODE" = true ]; then
    echo "$SSH_PRIVATE_KEY" | ssh-add -
  else
    echo "$SSH_PRIVATE_KEY" | ssh-add - 2>/dev/null
  fi
fi

# SSH into the host using the loaded key
debug_log "Connecting to $USER_HOST using key '$KEY_NAME'..."
ssh "${SSH_OPTS[@]}" "$USER_HOST"

exit 0
