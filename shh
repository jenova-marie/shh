#!/bin/bash

# Exit on errors
set -e

# Region priority: Command line > SHH_REGION > AWS_REGION > AWS_DEFAULT_REGION > default
DEFAULT_REGION=${SHH_REGION:-${AWS_REGION:-${AWS_DEFAULT_REGION:-"us-east-2"}}}
DEFAULT_SECRET_NAME=${SHH_SECRETS:-"testing-secrets-x"}

# Function to display usage
usage() {
  echo "Usage: $(basename "$0") <user@host> <key-name> [region] [options]"
  echo ""
  echo "Arguments:"
  echo "  user@host      Remote SSH destination"
  echo "  key-name       Name of the SSH key stored in AWS Secrets Manager"
  echo "  region         AWS region (default: $DEFAULT_REGION)"
  echo ""
  echo "Environment variables (in order of precedence):"
  echo "  SHH_REGION           Preferred AWS region"
  echo "  AWS_REGION           Alternative AWS region"
  echo "  AWS_DEFAULT_REGION   Default AWS region"
  echo "  SHH_SECRETS          AWS Secrets Manager secret name"
  exit 1
}

# Check dependencies
check_dependencies() {
  for cmd in aws jq base64 ssh-add ssh-agent grep; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
      echo "Error: Required command '$cmd' not found. Please install it." >&2
      exit 1
    fi
  done
}

# Function to check AWS credentials
check_aws_credentials() {
  if ! aws sts get-caller-identity --region "$1" >/dev/null 2>&1; then
    echo "Error: AWS credentials not found or invalid. Run 'aws configure' to set them up." >&2
    return 1
  fi
  return 0
}

# Parse arguments
if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  usage
fi

# Parameters
USER_HOST="$1"
KEY_NAME="$2"
REGION="${3:-$DEFAULT_REGION}"
SECRET_NAME="${SHH_SECRETS:-$DEFAULT_SECRET_NAME}"

# Export values for potential use by other scripts
export SHH_SECRETS="$SECRET_NAME"
export SHH_REGION="$REGION"
export AWS_DEFAULT_REGION="$REGION"

# Check dependencies
check_dependencies

# Check AWS credentials
if ! check_aws_credentials "$REGION"; then
  exit 1
fi

# Start ssh-agent if not running
if ! pgrep -x "ssh-agent" >/dev/null 2>&1; then
  echo "Starting ssh-agent..."
  eval "$(ssh-agent -s)" >/dev/null
fi

echo "Retrieving key '$KEY_NAME' from secret '$SECRET_NAME' in region '$REGION'..."

# Retrieve the SSH key from AWS Secrets Manager
if ! SECRET_JSON=$(aws secretsmanager get-secret-value --secret-id "$SECRET_NAME" --region "$REGION" --query SecretString --output text 2>/dev/null); then
  echo "Error: Failed to retrieve secret '$SECRET_NAME' from AWS Secrets Manager in region '$REGION'!" >&2
  exit 1
fi

# Extract private key using jq (base64 encoded)
SSH_PRIVATE_KEY_B64=$(echo "$SECRET_JSON" | jq -r --arg key "$KEY_NAME" '.[$key] // empty')
if [ -z "$SSH_PRIVATE_KEY_B64" ]; then
  echo "Error: Key '$KEY_NAME' not found in secret '$SECRET_NAME'!" >&2
  echo "Available keys:" >&2
  echo "$SECRET_JSON" | jq -r 'keys[]' | sort >&2
  exit 1
fi

# Decode the base64-encoded private key
SSH_PRIVATE_KEY=$(echo "$SSH_PRIVATE_KEY_B64" | base64 --decode)

# Try to get fingerprint and public key if they exist
SSH_PUBLIC_KEY=$(echo "$SECRET_JSON" | jq -r --arg key "$KEY_NAME.pub" '.[$key] // empty')
SSH_PUBLIC_KEY_FP=$(echo "$SECRET_JSON" | jq -r --arg key "$KEY_NAME.fp" '.[$key] // empty')

# Check if the key is already in ssh-agent using fingerprint
if [ -n "$SSH_PUBLIC_KEY_FP" ]; then
  if ssh-add -l 2>/dev/null | grep -q "$SSH_PUBLIC_KEY_FP"; then
    echo "Key '$KEY_NAME' is already loaded in ssh-agent, skipping ssh-add."
    IS_KEY_LOADED=true
  else
    echo "Key '$KEY_NAME' not loaded in ssh-agent, adding it now..."
    IS_KEY_LOADED=false
  fi
else
  echo "Key fingerprint not found in secret, can't check if key is loaded in ssh-agent."
  echo "Will attempt to load the key."
  IS_KEY_LOADED=false
fi

# Add key to ssh-agent if not already loaded
if [ "$IS_KEY_LOADED" = false ]; then
  # Create a temporary file for the key with restricted permissions
  SSH_KEY_TEMP=$(mktemp)
  chmod 600 "$SSH_KEY_TEMP"
  echo "$SSH_PRIVATE_KEY" > "$SSH_KEY_TEMP"
  
  # Add the key to ssh-agent
  ssh-add "$SSH_KEY_TEMP"
  
  # Remove the temporary file
  rm -f "$SSH_KEY_TEMP"
fi

# SSH into the host using the loaded key
echo "Connecting to $USER_HOST..."
ssh -v -o StrictHostKeyChecking=accept-new "$USER_HOST"

# No need to remove the key from ssh-agent as it might be used for other connections
# If needed, uncomment the following:
# if [ "$IS_KEY_LOADED" = false ] && [ -n "$SSH_PUBLIC_KEY_FP" ]; then
#   echo "Removing key from ssh-agent..."
#   ssh-add -d "$SSH_KEY_TEMP"
# fi

exit 0
