#!/bin/bash

# Exit on errors
set -e

# Ensure required arguments are provided
if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "Usage: $0 <user@host> <json-key-name> [aws-region]"
  exit 1
fi

# Parameters
USER_HOST="$1"
JSON_KEY_NAME="$2"
CHANGE_REGION="${3:-us-east-1}"  # Default to us-east-1 if not provided

# Temporarily set AWS region for this script execution
export AWS_REGION="$CHANGE_REGION"

# Start ssh-agent if not running
if ! pgrep -x "ssh-agent" >/dev/null; then
  eval "$(ssh-agent -s)"
fi

echo "RETRIEVING SHH_SECRETS: $AWS_REGION:$SHH_SECRETS#$JSON_KEY_NAME"

# Retrieve the JSON secret from AWS Secrets Manager
# keys must be base64 encoded to retain proper formatting within JSON
SSH_PRIVATE_KEY=$(/usr/local/lib/summon/summon-aws-secrets "$SHH_SECRETS#$JSON_KEY_NAME" | base64 --decode ) # 2>/dev/null)
SSH_PUBLIC_KEY=$(/usr/local/lib/summon/summon-aws-secrets "$SHH_SECRETS#${JSON_KEY_NAME}.pub" | base64 --decode ) # 2>/dev/null)

# Check if we successfully retrieved the secret
if [ -z "$SSH_PRIVATE_KEY" ]; then
  echo "Error: Failed to retrieve secret $SHH_SECRETS from AWS Secrets Manager in region $AWS_REGION!"
  exit 1
fi

# Extract public key fingerprint
SSH_KEY_FP=$(echo "$SSH_PRIVATE_KEY" | ssh-keygen -lf - | awk '{print $2}')

# Check if the key is already in ssh-agent
if ! ssh-add -l | grep -q "$SSH_KEY_FP"; then
  echo "$SSH_PRIVATE_KEY" | ssh-add - <<< "$SSH_PRIVATE_KEY"
else
  echo "Key is already loaded in ssh-agent, skipping ssh-add."
fi

# SSH into the host using the key we just added
ssh -o StrictHostKeyChecking=no "$USER_HOST"

# Cleanup: Remove key from ssh-agent after use
# ssh-add -d "$SSH_KEY_FP"
